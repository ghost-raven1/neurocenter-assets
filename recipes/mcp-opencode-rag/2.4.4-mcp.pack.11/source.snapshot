ImM+n7+QTriRXyXim0mBrTXNeqzVF0KWGgHPeiyViFFrNDw==\"\n    },\n    \"yargs-parser\": {\n      \"version\": \"21.1.1\",\n      \"resolved\": \"https://registry.npmjs.org/yargs-parser/-/yargs-parser-21.1.1.tgz\",\n      \"integrity\": \"sha512-tVpsJW7DdjecAiFpbIB1e3qxIQsE6NoPc5/eTdrbbIC4h0LVsWhnoa3g+m2HclBIujHzsxZ4VJVA+GUuc2/LBw==\",\n      \"dev\": true\n    },\n    \"yauzl\": {\n      \"version\": \"3.4.0\",\n      \"resolved\": \"https://registry.npmjs.org/yauzl/-/yauzl-3.4.0.tgz\",\n      \"integrity\": \"sha512-jIH9yLR9wqr0wOS0TpBvo/g/2UgZH5qePVbjgRliiF0BYvOZyaBknKsF+x9Iht0O6sqgnB93rCICdOZFecJuDw==\",\n      \"requires\": {\n        \"pend\": \"~1.2.0\"\n      }\n    },\n    \"yn\": {\n      \"version\": \"3.1.1\",\n      \"resolved\": \"https://registry.npmjs.org/yn/-/yn-3.1.1.tgz\",\n      \"integrity\": \"sha1-HodAGgnXZ8HV6rJqbkwYUYLS61A=\",\n      \"dev\": true\n    },\n    \"yoctocolors-cjs\": {\n      \"version\": \"2.1.3\",\n      \"resolved\": \"https://registry.npmjs.org/yoctocolors-cjs/-/yoctocolors-cjs-2.1.3.tgz\",\n      \"integrity\": \"sha512-U/PBtDf35ff0D8X8D0jfdzHYEPFxAI7jJlxZXwCSez5M3190m+QobIfh+sWDWSHMCWWJN2AWamkegn6vr6YBTw==\",\n      \"dev\": true\n    }\n  }\n}\n"
    },
    {
      "path": "services/catalog-service/package.json",
      "content": "{\n  \"name\": \"catalog-service\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"Каталожный microservice lancedb-storage (проекты/версии/скиллы/пакеты/операции/аудит/maintenance)\",\n  \"scripts\": {\n    \"test\": \"vitest run\",\n    \"build\": \"nest build\",\n    \"start\": \"nest start\",\n    \"start:dev\": \"nest start --watch\",\n    \"start:prod\": \"node dist/main.js\",\n    \"typecheck\": \"tsc -p tsconfig.build.json --noEmit\",\n    \"test:coverage\": \"vitest run --coverage\"\n  },\n  \"dependencies\": {\n    \"@lancedb/lancedb\": \"0.29.0\",\n    \"@nestjs/common\": \"11.2.7\",\n    \"@nestjs/core\": \"11.2.7\",\n    \"@nestjs/platform-express\": \"11.2.7\",\n    \"@neurocenter/asset-contract\": \"https://codeload.github.com/ghost-raven1/neurocenter-assets/tar.gz/2bcbdcbd77d003c078ce6357d64375de6ede1ff6\",\n    \"@renovatebot/pep440\": \"5.0.1\",\n    \"acorn\": \"8.18.0\",\n    \"esbuild\": \"0.28.2\",\n    \"js-yaml\": \"5.2.2\",\n    \"mammoth\": \"1.12.0\",\n    \"minio\": \"8.0.7\",\n    \"pdfjs-dist\": \"6.3.289\",\n    \"pg\": \"^8.11.0\",\n    \"reflect-metadata\": \"^0.1.13\",\n    \"rxjs\": \"^7.8.1\",\n    \"smol-toml\": \"1.9.1\",\n    \"tar\": \"7.5.22\",\n    \"yauzl\": \"3.4.0\"\n  },\n  \"devDependencies\": {\n    \"@nestjs/cli\": \"11.0.24\",\n    \"@nestjs/schematics\": \"11.1.0\",\n    \"@types/express\": \"4.17.21\",\n    \"@types/node\": \"^20.19.0\",\n    \"@types/pg\": \"^8.11.9\",\n    \"@vitest/coverage-v8\": \"4.1.12\",\n    \"ts-loader\": \"^9.5.1\",\n    \"ts-node\": \"^10.9.2\",\n    \"tsconfig-paths\": \"^4.2.0\",\n    \"typescript\": \"5.9.3\",\n    \"vitest\": \"4.1.12\"\n  }\n}\n"
    },
    {
      "path": "services/catalog-service/src/catalog/dto.ts",
      "content": "/**\n * DTO каталога — структуры ответов microservice (структурно совпадают с\n * `frontend/src/core/api/interfaces.ts`).\n */\n\nimport type { IDependencyPin } from '../../../shared/dependency-pins.cjs';\n\nexport type TSnapshotStatus = 'UPLOADING' | 'VERIFYING' | 'VERIFIED' | 'REJECTED' | 'DELETING' | 'DELETED';\nexport type TOperationState = 'QUEUED' | 'RUNNING' | 'SUCCEEDED' | 'FAILED' | 'CANCELLED' | 'CONFLICT';\nexport type TOperationType = 'UPLOAD' | 'VERIFY' | 'DOWNLOAD' | 'SYNC' | 'RELEASE' | 'DELETE' | 'INSTALL' | 'CATALOG' | 'PROJECT' | 'BUILD' | 'MODEL';\nexport type TProjectState = 'ACTIVE' | 'ARCHIVED' | 'LOCKED';\n\nexport interface IPage<T> {\n    items: T[];\n    page: number;\n    size: number;\n    total: number;\n}\n\nexport interface IQuota {\n    currentBytesLimit: number;\n    currentBytesUsed: number | null;\n    retentionBytesLimit: number;\n    retentionBytesUsed: number | null;\n    stagingBytesLimit: number;\n    stagingBytesUsed: number;\n}\n\nexport interface IProjectSummary {\n    id: string;\n    name: string;\n    externalResourceId: string;\n    fsRootPath: string;\n    state: TProjectState;\n    head: { snapshotId: string; snapshotDate: string; author: string; headRevision: number } | null;\n    headRevision: number;\n    logicalBytes: number | null;\n    retainedBytes: number | null;\n    logicalSizeError?: string;\n    retainedSizeError?: string;\n    retention: number;\n    activeProfileId: string | null;\n    activeProfileRevision: number;\n    activeOperations: number;\n}\n\nexport interface IProjectDetail extends IProjectSummary {\n    createdAt: string;\n    quota: IQuota;\n}\n\n/**\n * Сотрудник (участник) проекта.\n */\nexport interface IProjectMember {\n    userId: string;\n    principalName: string;\n    displayName: string;\n    role: string;\n    addedAt: string;\n}\n\n/**\n * Payload добавления сотрудника в проект.\n */\nexport interface IProjectMemberAdd {\n    principalName: string;\n    displayName?: string;\n    role?: string;\n}\n\n/** Проект из доступов пользователя (строка таблицы «Доступ»). */\nexport interface IAccessProjectRef {\n    projectId: string;\n    projectName: string;\n    /** Id участника в project_members (для смены роли/удаления без фабрикации на фронтенде). */\n    userId: string;\n    role: string;\n}\n\n/** Пользователь и проекты, к которым у него есть доступ. */\nexport interface IAccessUserRow {\n    principalName: string;\n    displayName: string;\n    accesses: IAccessProjectRef[];\n}\n\n/** Ответ GET /api/access/users. */\nexport interface IAccessUsersList {\n    users: IAccessUserRow[];\n}\n\nexport interface IImageVersion {\n    snapshotId: string;\n    storeId: string;\n    parentId: string | null;\n    status: TSnapshotStatus;\n    author: string;\n    createdAt: string;\n    bytes: number;\n    formatVersion: string;\n    isHead: boolean;\n    pinned: boolean;\n}\n\nexport interface IHeadUpdateResult {\n    headId: string;\n    headRevision: number;\n}\n\nexport interface ISkillPin {\n    id: string;\n    version: number;\n    manifest: string;\n}\n\nexport interface IProfileReleaseResult {\n    profileId: string;\n    profileRevision: number;\n    head: IHeadUpdateResult | null;\n}\n\nexport interface IProjectProfile {\n    profileId: string;\n    snapshotId: string;\n    revision: number;\n    isActive: boolean;\n    skillPins: ISkillPin[];\n}\n\nexport interface ISnapshotManifest {\n    snapshotId: string;\n    tables: { name: string; tableVersion: number }[];\n    files: { path: string; size: number; sha256: string }[];\n    signature: string;\n}\n\nexport interface IOperation {\n    operationId: string;\n    type: TOperationType;\n    projectId: string | null;\n    resourceType: string;\n    resourceId: string;\n    actor: string;\n    state: TOperationState;\n    percent: number;\n    bytesDone: number;\n    bytesTotal: number;\n    startedAt: string | null;\n    finishedAt: string | null;\n    error: string | null;\n    bridgeJob?: { kind: string; retrySupported: boolean; minimumLevel: number };\n    actions?: {\n        executor: 'bridge'|'rag-reindex'|'model-hosting'|'tool-build'|'history'; digest: string;\n        retry: {supported:boolean;reason?:string}; cancel: {supported:boolean;reason?:string};\n    };\n}\n\nexport interface IOperationDetail extends IOperation {\n    log: { at: string; level: string; message: string }[];\n    retries: number;\n}\n\nexport interface IAuditEvent {\n    source?: 'operation'|'security';\n    details?: {before:unknown;after:unknown}|null;\n    id: string;\n    at: string;\n    actor: string;\n    versionAuthor: string;\n    action: string;\n    resourceType: string;\n    resourceId: string;\n    outcome: string;\n    decisionId: string;\n    correlationId: string;\n}\n\nexport interface IStorageSummary {\n    totalBytesUsed: number;\n    totalBytesLimit: number;\n    buckets: { name: string; bytesUsed: number }[];\n    stagingBytesBudget: number;\n}\n\nexport interface IBackupStatus {\n    lastBackupAt: string | null;\n    backupLagSeconds: number;\n    restoreDrills: { at: string; result: string }[];\n}\n\n/** Файл MCP/плагина (манифест; бинарные — в origin/объектном хранилище). */\nexport interface IAiPluginFile {\n    path: string;\n    size: number;\n    digest: string;\n    /** Текстовое содержимое файла (текстовые бандлы: skill/plugin/mcp). */\n    content?: string;\n}\n\n/** Неизменяемая версия бандла MCP/плагина (дерево файлов + конфиг). */\nexport interface IAiPluginVersion {\n    version: number;\n    files: IAiPluginFile[];\n    config: IAiPluginConfig | null;\n    author: string;\n    note: string;\n    createdAt: string;\n    metadata?: Pick<IAiPlugin, 'kind' | 'description' | 'compatibility' | 'tags' | 'origin' | 'revision' | 'dependencies'>;\n}\n\n/** Конфиг подключения MCP-сервера / плагина (stdio или remote). */\nexport interface IAiPluginConfig {\n    transport?: 'stdio' | 'remote';\n    command?: string;\n    args?: string[];\n    env?: Record<string, string>;\n    url?: string;\n    headers?: Record<string, string>;\n    extra?: Record<string, unknown>;\n    /** Явная точка входа текстового пакета. */\n    entrypoint?: string;\n    /** false отключает OAuth; без поля OpenCode определяет его автоматически. */\n    oauth?: false;\n}\n\n/** MCP-сервер или плагин — отдельная сущность каталога. */\nexport interface IAiPlugin {\n    archivedAt?: string;\n    id: string;\n    name: string;\n    kind: 'mcp' | 'plugin';\n    description: string;\n    version: number;\n    compatibility: string | null;\n    tags: string[];\n    /** Источник файлов: 'git:<url>' | 'upload' | 'internal'. */\n    origin: string;\n    /** Git-референс (ветка/тег) при origin=git. */\n    revision: string | null;\n    config: IAiPluginConfig | null;\n    files: IAiPluginFile[];\n    /** Закреплённые зависимости входят в неизменяемое содержимое версии. */\n    dependencies?: IDependencyPin[];\n    createdAt: string;\n    updatedAt: string;\n}\n\n/** Payload создания MCP/плагина. */\nexport interface IAiPluginCreate {\n    name: string;\n    kind: 'mcp' | 'plugin';\n    description: string;\n    version?: number;\n    compatibility?: string;\n    tags?: string[];\n    origin?: string;\n    revision?: string | null;\n    config?: IAiPluginConfig | null;\n    files?: IAiPluginFile[];\n    dependencies?: IDependencyPin[];\n    /** Один ключ сохраняется при повторной отправке той же формы. */\n    publicationKey?: string;\n}\n\n/** Итог автосоздания проектов из локальных каталогов. */\nexport interface ILocalProjectsImportResult {\n    created: number;\n    existing: number;\n    total: number;\n    createdNames: string[];\n}\n\n\n\n/** Payload обновления MCP/плагина. */\nexport interface IAiPluginUpdate {\n    kind?: 'mcp' | 'plugin';\n    description?: string;\n    version?: number;\n    compatibility?: string | null;\n    tags?: string[];\n    origin?: string;\n    revision?: string | null;\n    config?: IAiPluginConfig | null;\n    files?: IAiPluginFile[];\n    dependencies?: IDependencyPin[];\n    /** Версия, которую редактировал пользователь; защищает от потери чужих изменений. */\n    expectedVersion?: number;\n}\n\nexport interface IAccessDecision {\n    scope: string;\n    scopeId: string;\n    actions: string[];\n    decisionId: string;\n    policyRevision: number;\n    ttlSeconds: number;\n}\n\nexport interface IAccessDecisionList {\n    decisions: IAccessDecision[];\n    externalServiceUrl: string | null;\n}\n\n/** Актив (глоб. бандл/скилл), добавленный проектным админом в проект. */\nexport interface IProjectAsset {\n    assetId: string;\n    assetKind: 'mcp' | 'plugin' | 'skill';\n    addedBy: string;\n    addedAt: string;\n    version?: number | null;\n    manifest?: string | null;\n    pinOrigin?: 'unresolved' | 'assigned' | 'manual' | 'migration-current';\n    pinError?: string;\n}\n\n/** Активность считается для всей области фильтра независимо от текущей страницы. */\nexport interface IOperationPage extends IPage<IOperation> {\n    activeCount: number;\n    /** Средний процент активных операций; без оценки байтов и оставшегося времени. */\n    activeProgress: { percent: number; running: number; queued: number };\n}\n"
    },
    {
      "path": "services/catalog-service/src/devices/mcp-config-schema.ts",
      "content": "import { createHash } from 'node:crypto';\nconst canonicalV4 = (value: unknown): unknown => Array.isArray(value) ? value.map(canonicalV4) : value && typeof value === 'object' ? Object.fromEntries(Object.entries(value).filter(([,item]) => item !== undefined).sort(([a],[b]) => a === b ? 0 : a < b ? -1 : 1).map(([key,item]) => [key,canonicalV4(item)])) : value;\n\nexport interface LocalConfigurationField {\n    id: string; label: string; type: 'string' | 'url' | 'number' | 'boolean'; required: boolean; secret?: boolean;\n    target: {kind: 'env' | 'header'; name: string; prefix?: string};\n}\nexport interface LocalConfigurationSchema {schemaVersion: 1; fields: LocalConfigurationField[]}\nexport type ConfigurationValues = Record<string, string | number | boolean>;\nconst forbiddenEnv = /^(HOME|USERPROFILE|PATH|SHELL|ENV|BASH_ENV|APPDATA|LOCALAPPDATA|TMPDIR|TMP|TEMP|NODE_OPTIONS|NODE_PATH|XDG_.*|OPENCODE_.*|BUN_.*|NPM_.*|PIP_.*|PYTHON.*|LD_.*|DYLD_.*)$/i;\nconst exact = (value: Record<string,unknown>, keys: string[]) => Object.keys(value).every(key => keys.includes(key));\n\n/** Схема не допускает исполняемые шаблоны, опасные переменные или неоднозначные назначения. */\nexport function parseLocalConfiguration(pkg: {plugin: {kind: string}; config: unknown}): LocalConfigurationSchema | undefined {\n    const config = pkg.config as {extra?: {localConfiguration?: unknown}; transport?: string} | null;\n    const source = config?.extra?.localConfiguration;\n    if (source === undefined) {return undefined;}\n    const schema = source as LocalConfigurationSchema;\n    if (pkg.plugin.kind !== 'mcp' || !schema || !exact(schema as unknown as Record<string,unknown>, ['schemaVersion','fields'])\n        || schema.schemaVersion !== 1 || !Array.isArray(schema.fields) || !schema.fields.length || schema.fields.length > 32) {throw new Error('Некорректная схема локальной настройки.');}\n    const ids = new Set<string>(); const targets = new Set<string>();\n    for (const field of schema.fields) {\n        if (!field || !exact(field as unknown as Record<string,unknown>, ['id','label','type','required','secret','target'])\n            || typeof field.id !== 'string' || !/^[a-z][a-zA-Z0-9_-]{0,63}$/.test(field.id) || ids.has(field.id)\n            || typeof field.label !== 'string' || !field.label.trim() || field.label.length > 160 || /[\\x00-\\x1f]/.test(field.label)\n            || !['string','url','number','boolean'].includes(field.type) || typeof field.required !== 'boolean'\n            || field.secret !== undefined && typeof field.secret !== 'boolean' || !field.target\n            || !exact(field.target as unknown as Record<string,unknown>, ['kind','name','prefix'])\n            || !['env','header'].includes(field.target.kind) || typeof field.target.name !== 'string'\n            || !/^[a-zA-Z_][a-zA-Z0-9_-]{0,127}$/.test(field.target.name)\n            || ['__proto__','prototype','constructor'].includes(field.target.name.toLowerCase())\n            || field.target.kind === 'env' && (config?.transport === 'remote' || !/^[a-zA-Z_][a-zA-Z0-9_]*$/.test(field.target.name) || forbiddenEnv.test(field.target.name))\n            || field.target.kind === 'header' && (config?.transport !== 'remote' || /^(host|content-length|connection|transfer-encoding|cookie|proxy-authorization)$/i.test(field.target.name))\n            || field.target.prefix !== undefined && (typeof field.target.prefix !== 'string' || field.target.prefix.length > 64 || /[\\x00-\\x1f\\x7f]/.test(field.target.prefix))) {throw new Error('Некорректное поле локальной настройки.');}\n        const target = field.target.kind + ':' + (field.target.kind === 'header' ? field.target.name.toLowerCase() : field.target.name);\n        if (targets.has(target)) {throw new Error('Параметры настройки имеют одинаковое назначение.');}\n        ids.add(field.id); targets.add(target);\n    }\n    return structuredClone(schema);\n}\nexport function localConfigurationDigest(schema: LocalConfigurationSchema): string {\n    return createHash('sha256').update(JSON.stringify(canonicalV4(schema))).digest('hex');\n}\n"
    },
    {
      "path": "services/catalog-service/src/publication/publication-runtime.ts",
      "content": "import { BadRequestException } from '@nestjs/common';\nimport type { IAiPluginConfig } from '../catalog/dto';\nimport { parseLocalConfiguration } from '../devices/mcp-config-schema';\nimport { normalizeRuntimeArtifacts, validateRuntimeArtifactEntrypoints, type RuntimeArtifact, type RuntimeArtifactEntry } from '../../../shared/runtime-artifacts.cjs';\nimport {localRagUi} from '../../../shared/rag-ui-contract.cjs';\n\n/** Публичная публикация принимает декларации поставки и настройки, без произвольных extra и секретных значений. */\nexport function publicationRuntimeExtra(value: unknown, kind: 'mcp' | 'plugin', transport?: unknown): IAiPluginConfig['extra'] {\n    if (value === undefined) { return undefined; }\n    if (!value || typeof value !== 'object' || Array.isArray(value)\n        || Object.keys(value).some(key => !['runtimeArtifacts', 'localConfiguration', 'localUi', 'hostedEmbedding','hostedMcp','researchMcp'].includes(key))) {\n        throw new BadRequestException('В extra поддерживаются runtimeArtifacts, localConfiguration, localUi, hostedEmbedding, hostedMcp и researchMcp. Зависимости задаются отдельно.');\n    }\n    const source = value as Record<string, unknown>;\n    try {\n        const artifacts = normalizeRuntimeArtifacts(source.runtimeArtifacts);\n        validateRuntimeArtifactEntrypoints(kind, artifacts);\n        if (transport === 'remote' && artifacts.length) { throw new Error('Удалённому MCP не нужен локальный готовый комплект.'); }\n        if(source.hostedMcp!==undefined&&(typeof source.hostedMcp!=='boolean'||kind!=='mcp'||transport==='remote'||!artifacts.length))throw new Error('hostedMcp требует локальный MCP с готовым комплектом Gateway.');\n        const research=source.researchMcp as {adapter?:unknown;tools?:unknown}|undefined;\n        if(research!==undefined&&(!research||typeof research!=='object'||Array.isArray(research)||Object.keys(research).some(key=>!['adapter','tools'].includes(key))\n            ||research.adapter!=='exa'||!Array.isArray(research.tools)||research.tools.length!==2||!['web_search_exa','web_fetch_exa'].every(name=>(research.tools as unknown[]).includes(name))\n            ||source.hostedMcp!==true))throw new Error('researchMcp требует одобренные search/fetch инструменты Exa и hostedMcp: true.');\n        const schema = parseLocalConfiguration({ plugin: { kind }, config: { transport, extra: source } });\n        const ui=localRagUi({schemaVersion:5,plugin:{kind},config:{transport,extra:{...source,runtimeArtifacts:artifacts}}});\n        const hosted = source.hostedEmbedding;\n        const marker = hosted as {schemaVersion?: unknown;profileSchemaVersion?: unknown;reindexSchemaVersion?:unknown}|undefined;\n        if (hosted !== undefined && (!hosted || typeof hosted !== 'object' || Array.isArray(hosted)\n            || Object.keys(hosted).some(key => !['schemaVersion','profileSchemaVersion','reindexSchemaVersion'].includes(key)) || marker?.schemaVersion !== 1 || marker?.reindexSchemaVersion !== undefined && marker.reindexSchemaVersion !== 1\n            || ('profileSchemaVersion' in hosted && marker?.profileSchemaVersion !== 2) || !ui)) {\n            throw new Error('hostedEmbedding требует schemaVersion: 1 и необязательный profileSchemaVersion: 2 в закреплённом OpenCodeRAG с localUi.');\n        }\n        return { ...(artifacts.length ? { runtimeArtifacts: artifacts } : {}), ...(schema ? { localConfiguration: schema } : {}), ...(ui?{localUi:ui}:{}),\n            ...(source.hostedMcp!==undefined?{hostedMcp:source.hostedMcp}:{}),...(research?{researchMcp:{adapter:'exa',tools:['web_search_exa','web_fetch_exa']}}:{}),\n            ...(hosted !== undefined ? {hostedEmbedding: {schemaVersion: 1,...(marker?.profileSchemaVersion === 2 ? {profileSchemaVersion: 2} : {}),...(marker?.reindexSchemaVersion===1?{reindexSchemaVersion:1}:{})}} : {}) };\n    } catch (error) { throw new BadRequestException(error instanceof Error ? error.message : 'Некорректная декларация готового комплекта или локальной настройки.'); }\n}\n\n/** Дополнительная UI-точка обязана входить в проверенную SHA-опись каждого платформенного архива. */\nexport function assertLocalUiInventory(config:IAiPluginConfig|null|undefined,kind:string,entries:RuntimeArtifactEntry[]):void{\n    const ui=localRagUi({schemaVersion:5,plugin:{kind},config});\n    if(ui&&!entries.some(entry=>entry.path===ui.entrypoint&&entry.size>0)){\n        throw new BadRequestException('Точка входа localUi отсутствует или пуста в описи готового комплекта.');\n    }\n}\n\n/** Старые необязательные поля не должны противоречить авторитетной платформенной точке входа. */\nexport function validateArtifactLaunchFields(source: Record<string, unknown>, artifacts: RuntimeArtifact[], localMcp = false): void {\n    if (source.entrypoint !== undefined && !artifacts.every(item => item.entrypoint === source.entrypoint)) {\n        throw new BadRequestException('Файл запуска задаётся в платформенном descriptor; уберите противоречащий entrypoint.');\n    }\n    if (localMcp && source.command !== undefined && (source.command !== 'node' || artifacts.some(item => item.executable === true))) {\n        throw new BadRequestException('Готовый комплект сам задаёт команду запуска. Внешняя команда и команда node для нативного комплекта не поддерживаются.');\n    }\n}\n"
    },
    {
      "path": "services/catalog-service/src/publication/publication-validation.ts",
      "content": "import { createHash } from 'node:crypto';\nimport { BadRequestException } from '@nestjs/common';\n\nimport type { IAiPluginConfig, IAiPluginCreate, IAiPluginFile } from '../catalog/dto';\nimport { publicationRuntimeExtra, validateArtifactLaunchFields } from './publication-runtime';\nimport { normalizeRuntimeArtifacts, portablePath } from '../../../shared/runtime-artifacts.cjs';\nimport { isSourceEntrypoint } from '../../../shared/source-entrypoint.cjs';\nimport { normalizeDependencyPins } from '../../../shared/dependency-pins.cjs';\n\nexport const MAX_PACKAGE_BYTES = 5 * 1024 * 1024;\nconst MAX_FILE_BYTES = 1024 * 1024;\nconst secretKey = /(?:token|secret|password|api[-_]?key|authorization|cookie)/i;\nconst envReference = /^\\{env:[A-Za-z_][A-Za-z0-9_]*\\}$/;\nconst authorizationReference = /^(?:Bearer|Basic) \\{env:[A-Za-z_][A-Za-z0-9_]*\\}$/i;\nconst forbiddenKey = new Set(['__proto__', 'prototype', 'constructor']);\n\n/** Проверяет структуру JSON до сохранения в общий каталог. */\nexport function object(value: unknown, label: string): Record<string, unknown> {\n    if (!value || typeof value !== 'object' || Array.isArray(value)) {\n        throw new BadRequestException(`${label}: ожидается JSON-объект.`);\n    }\n    return value as Record<string, unknown>;\n}\n\nfunction text(value: unknown, label: string, limit: number, required = true): string {\n    if (typeof value !== 'string' || value.includes('\\0')) { throw new BadRequestException(`${label}: ожидается текст.`); }\n    const result = value.trim().normalize('NFC');\n    if ((required && !result) || result.length > limit) { throw new BadRequestException(`${label}: от ${required ? 1 : 0} до ${limit} символов.`); }\n    return result;\n}\n\n/** Пути остаются одинаковыми на Windows, macOS и Linux; исправлять опасный путь молча нельзя. */\nexport function filePath(value: unknown): string {\n    if (typeof value !== 'string') {throw new BadRequestException('Путь файла: ожидается текст.');}\n    if (value.trim() !== value || !portablePath(value) || value.split('/').some(part =>\n        ['.git', '.env', '.npmrc', '.yarnrc', '.yarnrc.yml', 'node_modules'].includes(part.toLowerCase())\n        || part.toLowerCase().startsWith('.env.') && part.toLowerCase() !== '.env.example')) {\n        throw new BadRequestException(`Недопустимый путь файла «${String(value)}». Используйте относительный путь через /. `);\n    }\n    return value;\n}\n\n/** Размеры и хэши вычисляются по UTF-8 на сервере, а не принимаются от клиента. */\nexport function packageFiles(value: unknown): IAiPluginFile[] {\n    if (!Array.isArray(value) || value.length > 100) { throw new BadRequestException('Допустимо до 100 текстовых файлов.'); }\n    const paths = new Set<string>();\n    let bytes = 0;\n    return value.map(raw => {\n        const file = object(raw, 'Файл');\n        const path = filePath(file.path);\n        const key = path.normalize('NFC').toLowerCase();\n        const ancestors = key.split('/').slice(0, -1).map((_, i, parts) => parts.slice(0, i + 1).join('/'));\n        if (paths.has(key) || ancestors.some(parent => paths.has(parent)) || [...paths].some(other => other.startsWith(`${key}/`))) {\n            throw new BadRequestException(`Файлы конфликтуют по пути «${path}», включая регистр букв.`);\n        }\n        paths.add(key);\n        if (typeof file.content !== 'string' || file.content.includes('\\0')) { throw new BadRequestException(`«${path}»: требуется текст UTF-8, бинарные файлы пока не поддерживаются.`); }\n        const size = Buffer.byteLength(file.content, 'utf8');\n        bytes += size;\n        if (size > MAX_FILE_BYTES || bytes > MAX_PACKAGE_BYTES) { throw new BadRequestException('Лимит: 1 МиБ на файл и 5 МиБ на пакет.'); }\n        return { path, content: file.content, size, digest: createHash('sha256').update(file.content, 'utf8').digest('hex') };\n    });\n}\n\nfunction stringMap(value: unknown, label: string, headers = false): Record<string, string> {\n    const entries = Object.entries(object(value, label));\n    if (entries.length > 50) { throw new BadRequestException(`${label}: не более 50 значений.`); }\n    const names = new Set<string>();\n    return Object.fromEntries(entries.map(([key, raw]) => {\n        const valid = headers ? /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/.test(key) : /^[A-Za-z_][A-Za-z0-9_]*$/.test(key);\n        if (!valid || forbiddenKey.has(key) || names.has(key.toLowerCase()) || typeof raw !== 'string' || raw.length > 4096 || /[\\x00\\r\\n]/.test(raw)) {\n            throw new BadRequestException(`${label}: проверьте имена и строковые значения.`);\n        }\n        names.add(key.toLowerCase());\n        const secretTemplate = envReference.test(raw) || headers && key.toLowerCase() === 'authorization' && authorizationReference.test(raw);\n        if ((secretKey.test(key) || headers && !['accept', 'content-type'].includes(key.toLowerCase())) && !secretTemplate) {\n            throw new BadRequestException(`${label}: секрет «${key}» замените ссылкой {env:ИМЯ_ПЕРЕМЕННОЙ}. Общий каталог виден командам.`);\n        }\n        return [key, raw];\n    }));\n}\n\n/** Нормализует только поддерживаемые настройки MCP; неизвестные поля не теряются молча. */\nexport function mcpConfig(value: unknown, files: IAiPluginFile[]): IAiPluginConfig {\n    const source = object(value, 'Настройки MCP');\n    const allowed = ['transport', 'command', 'args', 'env', 'url', 'headers', 'oauth', 'entrypoint', 'extra'];\n    if (Object.keys(source).some(key => !allowed.includes(key))) { throw new BadRequestException('В настройках MCP есть неподдерживаемые поля.'); }\n    const extra = publicationRuntimeExtra(source.extra, 'mcp', source.transport);\n    const artifacts = normalizeRuntimeArtifacts(extra?.runtimeArtifacts);\n    if (source.transport === 'remote') {\n        if (files.length || ['command', 'args', 'env', 'entrypoint'].some(key => source[key] !== undefined)) { throw new BadRequestException('Удалённый MCP задаётся URL и заголовками, без локальных файлов и команды.'); }\n        const url = text(source.url, 'URL MCP', 2048);\n        let parsed: URL;\n        try { parsed = new URL(url); } catch { throw new BadRequestException('Укажите полный http:// или https:// URL MCP.'); }\n        if (/[\\x00-\\x1f\\x7f]/.test(url) || !['http:', 'https:'].includes(parsed.protocol) || parsed.username || parsed.password || parsed.hash\n            || [...parsed.searchParams.keys()].some(key => secretKey.test(key))) { throw new BadRequestException('URL MCP должен быть HTTP(S), без пароля, токена и фрагмента.'); }\n        if (source.oauth !== undefined && source.oauth !== false) { throw new BadRequestException('Поддерживается автоматический OAuth или oauth: false. Регистрация собственного OAuth-клиента пока недоступна.'); }\n        return { transport: 'remote', url, ...(source.headers !== undefined ? {headers: stringMap(source.headers, 'Заголовки', true)} : {}), ...(source.oauth === false ? {oauth: false as const} : {}), ...(extra ? {extra} : {}) };\n    }\n    if (source.transport !== 'stdio' || ['url', 'headers', 'oauth'].some(key => source[key] !== undefined)) { throw new BadRequestException('Выберите локальный или удалённый MCP и заполните соответствующие настройки.'); }\n    const command = artifacts.length && source.command === undefined ? undefined : text(source.command, 'Команда', 500);\n    if (command !== undefined && /[\\x00-\\x1f\\x7f]/.test(command)) { throw new BadRequestException('Команда должна содержать путь к программе без переноса строки.'); }\n    if (source.args !== undefined && (!Array.isArray(source.args) || source.args.length > 64 || source.args.some(arg => typeof arg !== 'string' || arg.length > 4096 || arg.includes('\\0')))) {\n        throw new BadRequestException('Аргументы: JSON-массив строк. Пробелы внутри аргумента сохраняются.');\n    }\n    const result: IAiPluginConfig = { transport: 'stdio', ...(command !== undefined ? {command} : {}), args: source.args as string[] ?? [], ...(extra ? {extra} : {}) };\n    if (source.env !== undefined) { result.env = stringMap(source.env, 'Окружение'); }\n    if (!artifacts.length && !files.length) {\n        throw new BadRequestException('Локальный MCP требует закреплённого пакета. Используйте «Упаковать инструмент» для npm, репозитория или готового runtime, либо добавьте JS-файлы с точкой входа.');\n    }\n    if (artifacts.length) {\n        validateArtifactLaunchFields(source, artifacts, true);\n        if (source.entrypoint !== undefined) { result.entrypoint = source.entrypoint as string; }\n    } else if (files.length) {\n        const entrypoint = filePath(source.entrypoint);\n        if (command !== 'node' || !/\\.(?:m?js|cjs)$/.test(entrypoint) || !files.some(file => file.path === entrypoint && file.content?.trim())) {\n            throw new BadRequestException('Для текстового MCP-пакета укажите команду node и непустой .js/.mjs/.cjs файл запуска из пакета.');\n        }\n        result.entrypoint = entrypoint;\n    }\n    return result;\n}\n\n/** Общий контракт ручной публикации и повторной отправки запроса. */\nexport function validatePublication(raw: unknown): IAiPluginCreate {\n    const body = object(raw, 'Публикация');\n    const allowed = ['name', 'kind', 'description', 'version', 'compatibility', 'tags', 'origin', 'revision', 'config', 'files', 'publicationKey', 'dependencies'];\n    if (Object.keys(body).some(key => !allowed.includes(key))) { throw new BadRequestException('В публикации есть неподдерживаемые поля.'); }\n    if (!['mcp', 'plugin'].includes(String(body.kind))) { throw new BadRequestException('Выберите тип инструмента: MCP или плагин.'); }\n    const name = text(body.name, 'Название', 128);\n    if (/^ai-plug-/i.test(name)) { throw new BadRequestException('Префикс ai-plug- зарезервирован для ID инструмента.'); }\n    if (/[\\x00-\\x1f\\x7f/\\\\]/.test(name) || forbiddenKey.has(name)) { throw new BadRequestException('Название содержит недопустимые символы.'); }\n    const description = text(body.description, 'Описание', 2000);\n    if (body.version !== undefined && body.version !== 1) { throw new BadRequestException('Первая версия равна 1. Новую версию создавайте через редактирование.'); }\n    if (body.tags !== undefined && (!Array.isArray(body.tags) || body.tags.length > 20)) { throw new BadRequestException('Укажите до 20 тегов.'); }\n    const tags = [...new Set((body.tags as unknown[] ?? []).map(tag => text(tag, 'Тег', 40)))];\n    let dependencies: ReturnType<typeof normalizeDependencyPins>;\n    try { dependencies = normalizeDependencyPins(body.dependencies); }\n    catch (error) { throw new BadRequestException((error as Error).message); }\n    const files = packageFiles(body.files ?? []);\n    let config: IAiPluginConfig | null;\n    if (body.kind === 'mcp') { config = mcpConfig(body.config, files); }\n    else {\n        const source = object(body.config, 'Файл запуска плагина');\n        if (Object.keys(source).some(key => !['entrypoint', 'extra'].includes(key))) { throw new BadRequestException('У плагина поддерживаются entrypoint и декларация готового комплекта.'); }\n        const extra = publicationRuntimeExtra(source.extra, 'plugin');\n        const artifacts = normalizeRuntimeArtifacts(extra?.runtimeArtifacts);\n        if (artifacts.length) {\n            validateArtifactLaunchFields(source, artifacts);\n            config = { ...(source.entrypoint !== undefined ? {entrypoint: source.entrypoint as string} : {}), ...(extra ? {extra} : {}) };\n        } else {\n            if (!files.length) { throw new BadRequestException('Добавьте файлы плагина или готовый платформенный комплект. Имя npm-пакета без файлов пока не поддерживается.'); }\n            const entrypoint = filePath(source.entrypoint);\n            if (!/\\.(?:m?js|cjs|ts)$/.test(entrypoint) || !isSourceEntrypoint(entrypoint) || !files.some(file => file.path === entrypoint && file.content?.trim())) { throw new BadRequestException('Укажите непустой JS/TS-файл запуска из файлов плагина, без деклараций типов.'); }\n            config = { entrypoint, ...(extra ? {extra} : {}) };\n        }\n    }\n    const publicationKey = body.publicationKey === undefined ? undefined : text(body.publicationKey, 'Ключ публикации', 36);\n    if (publicationKey !== undefined && !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(publicationKey)) { throw new BadRequestException('Некорректный ключ публикации.'); }\n    return { name, kind: body.kind as 'mcp' | 'plugin', description, tags, files, config, version: 1,\n        origin: body.origin === undefined ? 'upload' : text(body.origin, 'Источник', 256),\n        compatibility: body.compatibility == null ? undefined : text(body.compatibility, 'Совместимость', 200, false),\n        revision: body.revision == null ? null : text(body.revision, 'Ревизия', 200, false), publicationKey,\n        ...(dependencies.length ? { dependencies } : {}) };\n}\n\n/** Порядок ключей JSON не меняет идентичность повторной публикации. */\nexport function publicationHash(value: unknown): string {\n    const canonical = (input: unknown): unknown => Array.isArray(input) ? input.map(canonical)\n        : input && typeof input === 'object' ? Object.fromEntries(Object.entries(input).filter(([, v]) => v !== undefined).sort(([a], [b]) => a.localeCompare(b)).map(([k, v]) => [k, canonical(v)])) : input;\n    return createHash('sha256').update(JSON.stringify(canonical(value)), 'utf8').digest('hex');\n}\n"
    },
    {
      "path": "services/catalog-service/tsconfig.build.json",
      "content": "{\n    \"extends\": \"./tsconfig.json\",\n    \"exclude\": [\"node_modules\", \"test\", \"dist\", \"**/*spec.ts\"]\n}\n"
    },
    {
      "path": "services/catalog-service/tsconfig.json",
      "content": "{\n    \"compilerOptions\": {\n        \"module\": \"commonjs\",\n        \"target\": \"ES2021\",\n        \"moduleResolution\": \"node\",\n        \"emitDecoratorMetadata\": true,\n        \"experimentalDecorators\": true,\n        \"allowSyntheticDefaultImports\": true,\n        \"esModuleInterop\": true,\n        \"strict\": true,\n        \"strictPropertyInitialization\": false,\n        \"noImplicitAny\": true,\n        \"noUnusedLocals\": true,\n        \"skipLibCheck\": true,\n        \"sourceMap\": true,\n        \"outDir\": \"./dist\",\n        \"baseUrl\": \"./\",\n        \"incremental\": true\n    },\n    \"include\": [\"src/**/*\"]\n}\n"
    },
    {
      "path": "services/shared/archive-source.cjs",
      "content": "'use strict';\nconst {portablePath}=require('./runtime-artifacts.cjs');\nconst {validateRuntimeSource}=require('./tool-runtime-source.cjs');\n/** Internal execution plan references one checked local archive; public import remains asset.json. */\nfunction validateArchiveSource(value){\n if(!value||typeof value!=='object'||Array.isArray(value)||Object.keys(value).some(key=>!['type','file','sha256','bytes','format','runtimeSource'].includes(key))||value.type!=='archive'||typeof value.file!=='string'||!portablePath(value.file)||!Number.isSafeInteger(value.bytes)||value.bytes<1||value.bytes>256*1024**2||!/^[a-f0-9]{64}$/.test(value.sha256??'')||!['zip','tar.gz','file'].includes(value.format))throw new Error('Локальный архив требует файл, SHA-256, размер и сгенерированный runtime.');\n const runtimeSource=validateRuntimeSource(value.runtimeSource);\n for(const bundle of Object.values(runtimeSource.assets)){\n  if(bundle.app.directory!=='.'||(!runtimeSource.python&&bundle.runtime&&bundle.runtime.directory!=='.')||(runtimeSource.python&&(!bundle.runtime?.url||bundle.runtime.directory!==undefined)))throw new Error('Локальный архив использует собственное приложение и готовый либо закреплённый Python runtime.');\n }\n return {type:'archive',file:value.file,sha256:value.sha256,bytes:value.bytes,format:value.format,runtimeSource};\n}\nmodule.exports={validateArchiveSource};\n"
    },
    {
      "path": "services/shared/codex-connector-pin.json",
      "content": "{\n  \"schemaVersion\": 1,\n  \"repository\": \"https://github.com/ghost-raven1/opencode_codex_bridge\",\n  \"sourceCommit\": \"de21db304bef59af6421079c10e8a43404fd09fa\",\n  \"version\": \"0.2.0\",\n  \"sdkVersion\": \"0.159.3\",\n  \"authOnly\": true,\n  \"files\": {\n    \"auth-session.ts\": \"f1be79a24e884e60843a435016b24fb2f8a7d90c56e17b1d0c14131db5e9bfda\",\n    \"auth-provider.ts\": \"55a4b680a8879dba2c15237c94f891a07bf66e15f4dee494ab839474fa67f11e\",\n    \"auth-login.ts\": \"3dacea708db56eb332fd123377eeb8ca0e2bd8bf4a7e65cfbc4f596f5ef71cea\",\n    \"connection.ts\": \"3a3bdbb87ff8376d49f2c975928a155c17291ffe8ca2c6004ee2d55dcf1bf162\",\n    \"executable.ts\": \"9391645d0eee4739f475e7ff709325bbb02f1f3f05175566a9501ea5a7bfc5e2\",\n    \"types.ts\": \"69b82afa9ba910cf773dddf8dc835d26fc5288dee17f6fb7a257199d2f4bc462\"\n  }\n}\n"
    },
    {
      "path": "services/shared/codex-connector-source.cjs",
      "content": "'use strict';\nconst pin=require('./codex-connector-pin.json');\n/** Only this immutable repository layout receives the auth-only model adapter. */\nconst CODEX_PLUGIN_SOURCE=Object.freeze({url:pin.repository,commit:pin.sourceCommit,subdirectory:'packages/bridge',entrypoint:'src/plugin.ts',adapter:'opencode-codex-bridge'});\nfunction isPreparedCodexRepository(source){\n return !!source&&source.url===CODEX_PLUGIN_SOURCE.url&&source.commit===CODEX_PLUGIN_SOURCE.commit\n  &&source.subdirectory===CODEX_PLUGIN_SOURCE.subdirectory&&(source.entrypoint===undefined||source.entrypoint===CODEX_PLUGIN_SOURCE.entrypoint)&&!source.runtimeSource;\n}\nmodule.exports={CODEX_PLUGIN_SOURCE,isPreparedCodexRepository};\n"
    },
    {
      "path": "services/shared/codex-connector-source.d.cts",
      "content": "export const CODEX_PLUGIN_SOURCE: Readonly<{url:string;commit:string;subdirectory:string;entrypoint:string;adapter:'opencode-codex-bridge'}>;\nexport function isPreparedCodexRepository(source:unknown):boolean;\n"
    },
    {
      "path": "services/shared/dependency-pins.cjs",
      "content": "'use strict';\n\n/** Проверяет точные ссылки на зависимости без поиска по имени или текущей версии. */\nfunction normalizeDependencyPins(value) {\n    if (value === undefined) { return []; }\n    if (!Array.isArray(value) || value.length > 20) { throw new TypeError('Зависимости: укажите до 20 точных версий MCP или плагинов.'); }\n    const seen = new Set();\n    return value.map(pin => {\n        if (!pin || typeof pin !== 'object' || Array.isArray(pin)\n            || Object.keys(pin).some(key => !['kind', 'id', 'version', 'manifest'].includes(key))\n            || !['mcp', 'plugin'].includes(pin.kind)\n            || typeof pin.id !== 'string' || !/^ai-plug-[a-z0-9][a-z0-9_-]{0,119}$/.test(pin.id)\n            || !Number.isSafeInteger(pin.version) || pin.version < 1\n            || typeof pin.manifest !== 'string' || !/^[a-f0-9]{64}$/.test(pin.manifest)) {\n            throw new TypeError('Зависимость должна содержать тип MCP/плагин, ID инструмента, точную версию и SHA-256 пакета.');\n        }\n        const key = pin.kind + ':' + pin.id;\n        if (seen.has(key)) { throw new TypeError('Одна зависимость не должна повторяться или требовать разные версии.'); }\n        seen.add(key);\n        return { kind: pin.kind, id: pin.id, version: pin.version, manifest: pin.manifest };\n    }).sort((a, b) => {\n        const left = a.kind + ':' + a.id;\n        const right = b.kind + ':' + b.id;\n        return left === right ? 0 : left < right ? -1 : 1;\n    });\n}\n\nmodule.exports = { normalizeDependencyPins };\n"
    },
    {
      "path": "services/shared/dependency-pins.d.cts",
      "content": "/** Точная версия зависимости; имя и последняя версия не участвуют в выборе пакета. */\nexport interface IDependencyPin {\n    kind: 'mcp' | 'plugin';\n    id: string;\n    version: number;\n    manifest: string;\n}\n\n/** Возвращает проверенные ссылки в стабильном порядке; отсутствие поля означает пустой набор. */\nexport function normalizeDependencyPins(value: unknown): IDependencyPin[];\n"
    },
    {
      "path": "services/shared/github-release-source.cjs",
      "content": "'use strict';\nconst {validateRuntimeSource}=require('./tool-runtime-source.cjs');\nconst {portablePath}=require('./runtime-artifacts.cjs');\nconst object=value=>!!value&&typeof value==='object'&&!Array.isArray(value);\nconst positive=value=>Number.isSafeInteger(value)&&value>0;\n/** Client pins release identity and asset bytes; generated runtime recipes remain server-owned. */\nfunction validateReleaseInput(value){\n if(!object(value)||Object.keys(value).some(key=>!['tag','asset','id','assetId','sha256'].includes(key))||typeof value.tag!=='string'||!value.tag||value.tag.length>200||/[\\x00-\\x20\\x7f\\\\]/.test(value.tag))throw new Error('Укажите тег релиза GitHub.');\n if(value.asset!==undefined&&(typeof value.asset!=='string'||!portablePath(value.asset)||value.asset.includes('/')))throw new Error('Укажите имя файла релиза без папок.');\n for(const key of ['id','assetId'])if(value[key]!==undefined&&!positive(value[key]))throw new Error('Некорректный идентификатор релиза GitHub.');\n if(value.sha256!==undefined&&!/^[a-f0-9]{64}$/.test(value.sha256))throw new Error('Некорректный SHA-256 файла релиза.');\n if((value.assetId!==undefined||value.sha256!==undefined)&&!value.asset)throw new Error('Закреплённому файлу нужно имя asset.');\n return {tag:value.tag,...(value.asset?{asset:value.asset}:{}),...(value.id?{id:value.id}:{}),...(value.assetId?{assetId:value.assetId}:{}),...(value.sha256?{sha256:value.sha256}:{})};\n}\nfunction releaseAsset(value,{owner,repository,tag}){\n if(!object(value)||!positive(value.id)||typeof value.name!=='string'||!portablePath(value.name)||value.name.includes('/')||!positive(value.size)||value.size>256*1024**2||value.state!=='uploaded')return;\n const format=/\\.(?:tar\\.gz|tgz)$/i.test(value.name)?'tar.gz':/\\.zip$/i.test(value.name)?'zip':/\\.(?:asc|sig|sha256|sha512|txt|json|ya?ml|md|pdf|png|jpe?g|svg|deb|rpm|dmg|pkg|msi|pdb)$/i.test(value.name)?undefined:'file';\n if(!format||/\\.(?:asc|sig|sha256|txt)$/i.test(value.name))return;\n const expected=`https://github.com/${owner}/${repository}/releases/download/${encodeURIComponent(tag)}/${encodeURIComponent(value.name)}`;\n let url;try{url=new URL(value.browser_download_url);}catch{return;}\n if(url.protocol!=='https:'||url.hostname!=='github.com'||url.port||url.username||url.password||url.search||url.hash)return;\n const parts=url.pathname.split('/').slice(1);\n let tail;try{tail=parts.slice(4).map(decodeURIComponent).join('/');}catch{return;}\n if(parts[0]?.toLowerCase()!==owner||parts[1]?.toLowerCase()!==repository||parts[2]!=='releases'||parts[3]!=='download'||tail!==tag+'/'+value.name)return;\n const sha256=typeof value.digest==='string'&&/^sha256:[a-f0-9]{64}$/.test(value.digest)?value.digest.slice(7):undefined;\n return {id:value.id,name:value.name,bytes:value.size,url:expected,format,...(sha256?{sha256}:{})};\n}\n/** Only API-confirmed release assets are offered; source-code ZIPs are not executable releases. */\nasync function resolveGithubRelease({source,parsed,repository,base,githubJson,fetcher,inspectAsset}){\n const requested=validateReleaseInput(source.release);\n const release=await githubJson(fetcher,base+(requested.tag==='latest'?'/releases/latest':'/releases/tags/'+encodeURIComponent(requested.tag)));\n if(!object(release)||!positive(release.id)||release.draft!==false||typeof release.tag_name!=='string'||!release.tag_name||!Array.isArray(release.assets)||release.assets.length>200)throw new Error('GitHub не подтвердил публичный релиз.');\n if(requested.id&&requested.id!==release.id)throw new Error('Релиз заменён после просмотра. Проверьте источник заново.');\n const tag=release.tag_name;\n const resolved=await githubJson(fetcher,base+'/commits/'+encodeURIComponent(tag));\n if(!object(resolved)||typeof resolved.sha!=='string'||!/^[a-f0-9]{40}(?:[a-f0-9]{24})?$/i.test(resolved.sha))throw new Error('GitHub не подтвердил commit тега релиза.');\n const commit=resolved.sha.toLowerCase();\n if(source.ref&&source.ref!==commit)throw new Error('Commit релиза изменился после просмотра. Проверьте источник заново.');\n const assets=release.assets.map(value=>releaseAsset(value,{...parsed,tag})).filter(Boolean);\n const common={url:source.url,commit,ref:commit,entrypoint:'',candidates:[],name:typeof repository.name==='string'?repository.name:parsed.repository,description:typeof repository.description==='string'?repository.description.slice(0,2000):'',release:{tag,id:release.id},releaseChoices:assets.map(({url,sha256,...asset})=>asset),runnableKinds:['mcp']};\n if(!assets.length)throw new Error('В релизе нет готовых ZIP, TAR.GZ или исполняемых файлов до 256 МиБ. Исходники доступны по ссылке репозитория.');\n const chosen=requested.asset?assets.find(asset=>asset.name===requested.asset):assets.length===1?assets[0]:undefined;\n if(requested.asset&&!chosen)throw new Error('Выбранный файл удалён из релиза. Проверьте источник заново.');\n if(!chosen)return {...common,requiresReleaseChoice:true,warnings:['Выберите готовую поставку релиза. Архивы исходников собираются через репозиторий.']};\n if(requested.assetId&&requested.assetId!==chosen.id||requested.sha256&&chosen.sha256&&requested.sha256!==chosen.sha256)throw new Error('Файл релиза заменён после просмотра. Проверьте источник заново.');\n if(typeof inspectAsset!=='function')throw new Error('Проверка содержимого релиза недоступна. Повторите позже.');\n const inspected=await inspectAsset({...chosen,...(requested.sha256?{sha256:requested.sha256}:{})},source.entrypoint);\n if(!object(inspected)||!/^[a-f0-9]{64}$/.test(inspected.sha256)||!Array.isArray(inspected.candidates)||typeof inspected.entrypoint!=='string')throw new Error('Не удалось проверить содержимое релиза.');\n if(requested.sha256&&requested.sha256!==inspected.sha256)throw new Error('SHA-256 файла релиза изменился после просмотра.');\n const pin={tag,id:release.id,asset:chosen.name,assetId:chosen.id,sha256:inspected.sha256};\n const runtimeSource=inspected.runtimeSource?validateRuntimeSource(inspected.runtimeSource):undefined;\n return {...common,...inspected,release:pin,recommendedKind:'mcp',...(runtimeSource?{runtimeSource,adapter:runtimeSource.adapter,supportedTargets:Object.keys(runtimeSource.assets)}:{}),requiresEntrypointChoice:inspected.candidates.length>1&&!inspected.entrypoint};\n}\nmodule.exports={validateReleaseInput,resolveGithubRelease};\n"
    },
    {
      "path": "services/shared/opencode-rag-source.cjs",
      "content": "'use strict';\nconst {TARGETS}=require('./runtime-artifacts.cjs');\n\n/** Совместимая поставка привязана к исходному commit MrDoe и опубликованной версии npm. */\nconst RAG_PLUGIN_SOURCE=Object.freeze({\n url:'https://github.com/mrdoe/opencoderag',commit:'4fb269c6f23a99701c7ac70fcc3f3e483c9f13ff',\n entrypoint:'src/plugin.ts',version:'2.4.4',adapter:'opencode-rag-plugin',\n supportedTargets:Object.freeze(TARGETS.filter(target=>target!=='darwin-x64')),\n});\n\n/** Другой commit, подпапка или точка входа не подменяются подготовленным пакетом. */\nfunction isPreparedRagRepository(source){\n return !!source&&source.url===RAG_PLUGIN_SOURCE.url&&source.commit===RAG_PLUGIN_SOURCE.commit\n  &&!source.subdirectory&&(source.entrypoint===undefined||source.entrypoint===RAG_PLUGIN_SOURCE.entrypoint);\n}\nmodule.exports={RAG_PLUGIN_SOURCE,isPreparedRagRepository};\n"
    },
    {
      "path": "services/shared/python-runtime-pins.cjs",
      "content": "'use strict';\n\nconst PYTHON_VERSION='3.12.15',UV_VERSION='0.13.4',PBS_RELEASE='20261020';\nconst python={\n 'darwin-arm64':{url:'https://github.com/astral-sh/python-build-standalone/releases/download/20261020/cpython-3.12.15%2B20261020-aarch64-apple-darwin-install_only_stripped.tar.gz',sha256:'e54a19fd9af218ddd4ed66bbec65f4e9062724ea848a0ddbd269e37765d9959e',bytes:25016814,platform:'aarch64-apple-darwin'},\n 'linux-x64-glibc':{url:'https://github.com/astral-sh/python-build-standalone/releases/download/20261020/cpython-3.12.15%2B20261020-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz',sha256:'7d6ef1164fb94c4b60d913340610fc7e0ef8e3d1b705aa5628b299b08cbdd4b5',bytes:34479233,platform:'x86_64-manylinux_2_17'},\n};\nconst uv={\n 'darwin-arm64':{url:'https://github.com/astral-sh/uv/releases/download/0.13.4/uv-aarch64-apple-darwin.tar.gz',sha256:'e0b1d4743ce64c55d9f0f4a444afa6b81125680070ee04e853fcd0f6c1ebf8f1',bytes:14326193,entrypoint:'uv-aarch64-apple-darwin/uv'},\n 'linux-x64-glibc':{url:'https://github.com/astral-sh/uv/releases/download/0.13.4/uv-x86_64-unknown-linux-gnu.tar.gz',sha256:'2b428396f12572d4429cf210ca234dd599a33b3af0958a4d5ed569d63e3f344f',bytes:16653835,entrypoint:'uv-x86_64-unknown-linux-gnu/uv'},\n};\nconst asset=pin=>({url:pin.url,sha256:pin.sha256,format:'tar.gz',entrypoint:pin.entrypoint??'python/bin/python3.12'});\n/** Inspectors retain exact runtime URLs and hashes before accepting a durable build. */\nfunction pythonRuntimeAssets(){return Object.fromEntries(Object.entries(python).map(([target,pin])=>[target,asset(pin)]));}\n/** Only these reviewed pins may execute on the producer; user declarations cannot replace them. */\nfunction pythonBuildPins(target){\n if(!python[target]||!uv[target])throw new Error('Автоматическая поставка Python поддерживает macOS ARM64 и Linux x64 glibc.');\n return {python:{...asset(python[target]),bytes:python[target].bytes},uv:{...asset(uv[target]),bytes:uv[target].bytes},platform:python[target].platform};\n}\nmodule.exports={PYTHON_VERSION,UV_VERSION,PBS_RELEASE,pythonRuntimeAssets,pythonBuildPins};\n"
    },
    {
      "path": "services/shared/python-runtime-pins.d.cts",
      "content": "import type {RemoteRuntimeAsset,RuntimeTarget} from './tool-runtime-source.cjs';\nexport const PYTHON_VERSION: '3.12.15';\nexport const UV_VERSION: '0.13.4';\nexport const PBS_RELEASE: '20261020';\nexport function pythonRuntimeAssets(): Partial<Record<RuntimeTarget,RemoteRuntimeAsset>>;\nexport function pythonBuildPins(target:string): {python:RemoteRuntimeAsset & {bytes:number};uv:RemoteRuntimeAsset & {bytes:number};platform:string};\n"
    },
    {
      "path": "services/shared/python-source-plan.cjs",
      "content": "'use strict';\nconst {portablePath}=require('./runtime-artifacts.cjs');\nconst object=value=>!!value&&typeof value==='object'&&!Array.isArray(value);\nconst exact=(value,keys)=>object(value)&&Object.keys(value).every(key=>keys.includes(key));\nconst dotted=/^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*$/;\nfunction relative(value,label){\n if(typeof value!=='string'||value!=='.'&&(!portablePath(value)||value.split('/').some(part=>part.toLowerCase()==='.git')))throw new Error(label+': нужен переносимый относительный путь.');\n return value;\n}\n/** Dependencies are data only: no pip options, paths, URLs, VCS references or line continuations. */\nfunction validatePythonRequirements(value){\n if(!Array.isArray(value)||value.length>1024)throw new Error('Зависимости Python должны быть статическим списком PEP 508.');\n return value.map(item=>{\n  if(typeof item!=='string'||item.length>4096||/[\\x00-\\x1f\\x7f\\\\/@:]/.test(item)||!/^\\s*[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?(?:\\s*\\[\\s*[A-Za-z0-9._-]+(?:\\s*,\\s*[A-Za-z0-9._-]+)*\\s*\\])?(?:\\s*(?:[<>=!~(]|;)[A-Za-z0-9_.+*<>=!~(),;\\[\\] '\"-]*)?\\s*$/.test(item))throw new Error('Зависимости Python: разрешены только имена PyPI, версии, extras и маркеры PEP 508; URL, VCS, локальные пути и параметры pip запрещены.');\n  return item.trim();\n });\n}\n/** Stable internal plan is persisted before a build is queued; it never contains executable setup commands. */\nfunction validatePythonPlan(value){\n if(!exact(value,['schemaVersion','projectDirectory','entry','searchPaths','requirements','requiresPython','distribution'])||value.schemaVersion!==1||!exact(value.entry,['type','value']))throw new Error('План Python требует schemaVersion: 1 и статическую точку входа.');\n const projectDirectory=relative(value.projectDirectory,'Папка Python'),entry=value.entry;\n if(!['script','module','callable'].includes(entry.type)||typeof entry.value!=='string'||entry.value.length>1024)throw new Error('Неизвестный тип точки входа Python.');\n if(entry.type==='script'){relative(entry.value,'Скрипт Python');if(entry.value==='.'||!entry.value.endsWith('.py'))throw new Error('Скрипт Python должен быть файлом .py.');}\n else if(entry.type==='module'?!dotted.test(entry.value):entry.value.split(':').length!==2||!entry.value.split(':').every(part=>dotted.test(part)))throw new Error('Точка входа Python должна быть module или module:callable, без выражений и аргументов.');\n if(!Array.isArray(value.searchPaths)||!value.searchPaths.length||value.searchPaths.length>16||new Set(value.searchPaths).size!==value.searchPaths.length)throw new Error('Пути импорта Python должны быть уникальными относительными каталогами.');\n const searchPaths=value.searchPaths.map(item=>relative(item,'Путь импорта Python')),requirements=validatePythonRequirements(value.requirements);\n if(value.requiresPython!==undefined&&(typeof value.requiresPython!=='string'||!value.requiresPython.trim()||value.requiresPython.length>512||!/^[\\dA-Za-z.*+!<>=~, -]+$/.test(value.requiresPython)))throw new Error('requires-python должен содержать статическое ограничение PEP 440.');\n if(value.distribution!==undefined&&(!exact(value.distribution,['name','version'])||typeof value.distribution.name!=='string'||value.distribution.name.length>200||!/^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$/.test(value.distribution.name)||typeof value.distribution.version!=='string'||!/^[A-Za-z0-9][A-Za-z0-9.!+_-]{0,127}$/.test(value.distribution.version)))throw new Error('Метаданные Python требуют статические name и version без управляющих символов.');\n return {schemaVersion:1,projectDirectory,entry:{type:entry.type,value:entry.value},searchPaths,requirements,...(value.requiresPython!==undefined?{requiresPython:value.requiresPython.trim()}:{}),...(value.distribution?{distribution:{name:value.distribution.name,version:value.distribution.version}}:{})};\n}\nmodule.exports={validatePythonPlan,validatePythonRequirements};\n"
    },
    {
      "path": "services/shared/python-source-plan.d.cts",
      "content": "export interface PythonSourcePlan {\n schemaVersion:1;\n projectDirectory:string;\n entry:{type:'script'|'module'|'callable';value:string};\n searchPaths:string[];\n requirements:string[];\n requiresPython?:string;\n distribution?:{name:string;version:string};\n}\nexport function validatePythonPlan(value:unknown):PythonSourcePlan;\nexport function validatePythonRequirements(value:unknown):string[];\n"
    },
    {
      "path": "services/shared/rag-index-contract.cjs",
      "content": "'use strict';\nconst {createHash}=require('node:crypto');\nconst FINGERPRINT_VERSION=1;\nconst object=value=>!!value&&typeof value==='object'&&!Array.isArray(value);\nconst clean=value=>typeof value==='string'?value.replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]/g,''):null;\nconst hash=value=>createHash('sha256').update(JSON.stringify(value)).digest('hex');\n/** Ключ повтора зависит от JSON-значений, а не порядка ключей после JSONB roundtrip. */\nfunction ragRequestHash(value){\n const canonical=item=>Array.isArray(item)?item.map(canonical):object(item)?Object.fromEntries(Object.keys(item).sort().map(key=>[key,canonical(item[key])])):item;\n return hash(canonical(value));\n}\n\n/** Только идентичность модели: адрес подключения и секреты в контракт не входят. */\nfunction normalizeIndexProfile(value){\n if(value===undefined||value===null)return null;\n if(!object(value)||Object.keys(value).sort().join(',')!=='dimension,model,provider'\n  ||typeof value.provider!=='string'||!/^[a-z][a-z0-9_-]{0,39}$/.test(value.provider)\n  ||typeof value.model!=='string'||!/^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$/.test(value.model)||value.model.includes('://')\n  ||!Number.isSafeInteger(value.dimension)||value.dimension<1||value.dimension>65535){throw new Error('Некорректный профиль индекса: нужны только provider, model и dimension.');}\n return {provider:value.provider,model:value.model,dimension:value.dimension};\n}\n\n/** Один формат текстов, nullable-полей и float32 для LanceDB и PostgreSQL. */\nfunction normalizeChunkRow(value){\n if(!object(value)||typeof value.id!=='string'||typeof value.filePath!=='string'||typeof value.content!=='string')throw new Error('Фрагменту нужны строковые id, filePath и content.');\n let embedding=null;\n if(value.embedding!==undefined&&value.embedding!==null){\n  if(!Array.isArray(value.embedding)||value.embedding.some(number=>typeof number!=='number'||!Number.isFinite(Math.fround(number))))throw new Error('Вектор содержит некорректное число float32.');\n  embedding=value.embedding.map(number=>Object.is(Math.fround(number),-0)?0:Math.fround(number));\n }\n return {id:value.id,filePath:clean(value.filePath),content:clean(value.content),description:clean(value.description),\n  startLine:value.startLine??null,endLine:value.endLine??null,language:clean(value.language),kind:clean(value.kind)??'',\n  role:clean(value.role),quirkType:clean(value.quirkType),tags:clean(value.tags),embedding};\n}\n\n/** Полный отпечаток меняется при изменении вектора или метаданных, даже без изменения content. */\nfunction rowFingerprint(value){return hash(normalizeChunkRow(value));}\n\n/** Порядок строк не влияет на seal; разные профили не разделяют один снимок. */\nfunction indexSnapshotHash(profile,fingerprints){\n const normalized=normalizeIndexProfile(profile);\n if(!normalized||!object(fingerprints))throw new Error('Снимку нужен профиль и полные отпечатки строк.');\n const entries=Object.entries(fingerprints);\n if(entries.some(([id,fingerprint])=>!id||typeof fingerprint!=='string'||!/^[a-f0-9]{64}$/.test(fingerprint)))throw new Error('Некорректный отпечаток строки снимка.');\n entries.sort(([left],[right])=>left<right?-1:left>right?1:0);\n return hash([FINGERPRINT_VERSION,normalized,entries]);\n}\n/** Локальная идентичность подключения без сохранения адреса, credentials или query-секретов. */\nfunction embeddingSignature(profile,baseUrl){\n const normalized=normalizeIndexProfile(profile);\n if(!normalized)throw new Error('Подключению нужен профиль индекса.');\n let endpoint='';\n if(baseUrl!==undefined&&baseUrl!==null&&baseUrl!==''){\n  if(typeof baseUrl!=='string')throw new Error('Некорректный адрес провайдера эмбеддингов.');\n  let parsed;try{parsed=new URL(baseUrl);}catch{throw new Error('Некорректный адрес провайдера эмбеддингов.');}\n  if(!['http:','https:'].includes(parsed.protocol))throw new Error('Некорректный адрес провайдера эмбеддингов.');\n  parsed.username='';parsed.password='';parsed.search='';parsed.hash='';\n  endpoint=parsed.toString().replace(/\\/+$/,'');\n }\n return hash([FINGERPRINT_VERSION,normalized,endpoint]);\n}\n/** Только локальные defaults управляемого плагина; явные параметры проекта имеют приоритет. */\nfunction managedEmbeddingConfiguration(value={}){\n if(!object(value))throw new Error('Некорректные локальные настройки embedding-модели.');\n const provider=value.provider??'ollama';\n const model=value.model??'qwen3-embedding:4b';\n const baseUrl=value.baseUrl??(provider==='ollama'?'http://127.0.0.1:11435/api':provider==='openai'?'http://127.0.0.1:11435/v1':undefined);\n let vectorDimension=value.vectorDimension;\n if(vectorDimension===undefined&&model==='qwen3-embedding:4b'){\n  try{const url=new URL(baseUrl);if(url.protocol==='http:'&&['127.0.0.1','localhost','[::1]'].includes(url.hostname)&&url.port==='11435'\n   &&url.pathname.replace(/\\/+$/,'')===(provider==='ollama'?'/api':provider==='openai'?'/v1':'')&&!url.username&&!url.password&&!url.search&&!url.hash)vectorDimension=2560;}catch{}\n }\n return {provider,model,...baseUrl!==undefined?{baseUrl}:{},...vectorDimension!==undefined?{vectorDimension}:{}};\n}\nmodule.exports={FINGERPRINT_VERSION,normalizeIndexProfile,normalizeChunkRow,rowFingerprint,indexSnapshotHash,embeddingSignature,managedEmbeddingConfiguration,ragRequestHash};\n"
    },
    {
      "path": "services/shared/rag-ui-contract.cjs",
      "content": "'use strict';\nconst ARGS=Object.freeze(['ui','--port','0','--no-open']);\n/** Только закреплённый локальный Web UI OpenCodeRAG; произвольные команды не поддерживаются. */\nfunction localRagUi(pkg){\n const value=pkg?.config?.extra?.localUi;\n if(value===undefined)return undefined;\n if(pkg.schemaVersion!==5||!['mcp','plugin'].includes(pkg.plugin?.kind)||pkg.config?.transport==='remote'\n  ||!Array.isArray(pkg.config?.extra?.runtimeArtifacts)||!pkg.config.extra.runtimeArtifacts.length\n  ||!value||typeof value!=='object'||Array.isArray(value)\n  ||Object.keys(value).sort().join(',')!=='application,args,entrypoint,schemaVersion'\n  ||value.schemaVersion!==1||value.application!=='opencode-rag'||value.entrypoint!=='opencode-rag.mjs'\n  ||JSON.stringify(value.args)!==JSON.stringify(ARGS))throw new Error('Эта версия не содержит поддерживаемого интерфейса OpenCodeRAG. Обновите инструмент.');\n return {schemaVersion:1,application:'opencode-rag',entrypoint:'opencode-rag.mjs',args:[...ARGS]};\n}\n/** Адрес готовности принимается только из собственного IPC, без внешних хостов и query-секретов. */\nfunction ragUiReady(value){\n const match=typeof value?.url==='string'&&value.url.match(/^http:\\/\\/127\\.0\\.0\\.1:([1-9]\\d{0,4})\\/#neurocenter-token=[a-f0-9]{48}$/);\n if(!value||typeof value!=='object'||Array.isArray(value)||Object.keys(value).sort().join(',')!=='port,type,url'\n  ||value.type!=='neurocenter-rag-ui-ready'||!Number.isInteger(value.port)||value.port<1||value.port>65535\n  ||!match||Number(match[1])!==value.port)throw new Error('Локальный интерфейс не подтвердил безопасную готовность.');\n return {url:value.url,port:value.port};\n}\nmodule.exports={localRagUi,ragUiReady};\n"
    },
    {
      "path": "services/shared/rag-ui-contract.d.cts",
      "content": "export interface LocalRagUi {schemaVersion:1;application:'opencode-rag';entrypoint:'opencode-rag.mjs';args:string[]}\nexport function localRagUi(pkg:unknown):LocalRagUi|undefined;\nexport function ragUiReady(value:unknown):{url:string;port:number};\n"
    },
    {
      "path": "services/shared/repository-source.cjs",
      "content": "'use strict';\nconst {createHash}=require('node:crypto');\nconst {portablePath}=require('./runtime-artifacts.cjs');\nconst {validateRuntimeSource,runtimeSourceTargets}=require('./tool-runtime-source.cjs');\nconst {isSourceEntrypoint,SOURCE_EXTENSIONS}=require('./source-entrypoint.cjs');\nconst {validateReleaseInput,resolveGithubRelease}=require('./github-release-source.cjs');\nconst {packageEntrypoints}=require('./source-candidates.cjs');\nconst {RAG_PLUGIN_SOURCE,isPreparedRagRepository}=require('./opencode-rag-source.cjs');\nconst object=value=>!!value&&typeof value==='object'&&!Array.isArray(value);\nconst exact=(value,keys)=>object(value)&&Object.keys(value).every(key=>keys.includes(key));\nconst commitPattern=/^(?:[a-f0-9]{40}|[a-f0-9]{64})$/i;\nconst manifestName='neurocenter.tool.json';\n\nfunction relativePath(value,label){\n if(typeof value!=='string'||!portablePath(value)||value.split('/').some(part=>part.toLowerCase()==='.git'))throw new Error(label+': нужен относительный переносимый путь без .. и .git.');\n return value;\n}\nfunction reference(value){\n if(typeof value!=='string'||value.length>200||!/^[a-z0-9][a-z0-9._+/-]*$/i.test(value)||value.split('/').some(part=>!part||part==='.'||part==='..')||value.includes('..'))throw new Error('Укажите ветку, тег или полный commit без управляющих символов и выражений Git.');\n return value;\n}\nfunction decode(value){try{return decodeURIComponent(value);}catch{throw new Error('Некорректное кодирование ссылки GitHub.');}}\n\n/** Tree/blob задают первый сегмент ветки; ветку со слешем можно уточнить полем ref. */\nfunction parseRepositoryUrl(value,options={}){\n if(typeof value!=='string'||value.length>2048||/[\\x00-\\x20\\x7f\\\\]/.test(value))throw new Error('Укажите публичный репозиторий https://github.com/владелец/репозиторий.');\n let parsed;try{parsed=new URL(value);}catch{throw new Error('Некорректная ссылка GitHub.');}\n if(parsed.protocol!=='https:'||parsed.hostname!=='github.com'||parsed.port||parsed.username||parsed.password||parsed.search||parsed.hash)throw new Error('Поддерживаются публичные HTTPS-репозитории github.com без токенов, параметров и фрагментов.');\n const rawPath=/^https:\\/\\/[^/]+(\\/[^?#]*)/i.exec(value)?.[1]||'';\n if(decode(rawPath).split('/').some(part=>part==='.'||part==='..'))throw new Error('Ссылка GitHub не должна содержать . или .. в пути.');\n const parts=parsed.pathname.replace(/\\/$/,'').split('/').slice(1);\n const owner=decode(parts[0]||''),repository=decode(parts[1]||'').replace(/\\.git$/i,'');\n if(!/^[a-z0-9][a-z0-9-]{0,38}$/i.test(owner)||!/^[a-z0-9._-]{1,100}$/i.test(repository)||repository==='.'||repository==='..')throw new Error('Некорректные владелец или имя репозитория GitHub.');\n let ref=options.ref===undefined||options.ref===''?undefined:reference(options.ref),subdirectory=options.subdirectory===undefined||options.subdirectory===''?undefined:relativePath(options.subdirectory,'Папка проекта');\n let release,entrypoint;\n if(parts[2]==='releases'){\n  if(parts[3]==='latest'&&parts.length===4)release={tag:'latest'};\n  else if(parts[3]==='tag'&&parts.length>=5)release={tag:parts.slice(4).map(decode).join('/')};\n  else if(parts[3]==='download'&&parts.length>=6)release={tag:parts.slice(4,-1).map(decode).join('/'),asset:decode(parts.at(-1))};\n  else throw new Error('Используйте ссылку /releases/tag/тег или /releases/download/тег/файл.');\n  release=validateReleaseInput(release);\n  if(subdirectory)throw new Error('Подпапка относится к исходникам, а не к файлу релиза.');\n }else if(parts.length>2){\n  const view=parts[2];\n  if(!['tree','blob'].includes(view)||parts.length<4||parts.slice(3).some(part=>!part))throw new Error('Используйте ссылку на репозиторий, /tree/ветка/папка или /blob/ветка/файл.');\n  const tail=parts.slice(3).map(decode).join('/');\n  const treeRef=ref??reference(decode(parts[3]));\n  if(tail!==treeRef&&!tail.startsWith(treeRef+'/'))throw new Error('Ветка ref не совпадает со ссылкой '+view+'. Укажите канонический URL репозитория и ref отдельно.');\n  const treeDirectory=tail===treeRef?undefined:relativePath(tail.slice(treeRef.length+1),'Путь в ссылке '+view);\n  if(view==='tree'){\n   if(subdirectory&&treeDirectory&&subdirectory!==treeDirectory)throw new Error('Папка subdirectory не совпадает с папкой в ссылке tree.');\n   subdirectory=subdirectory??treeDirectory;\n  }else{\n   const file=treeDirectory;\n   if(!file||!isSourceEntrypoint(file)&&!file.endsWith('.py')&&!/(?:^|\\/)SKILL\\.md$/.test(file)&&file.split('/').at(-1)!==manifestName)throw new Error('Ссылка blob должна указывать на SKILL.md, исполняемый JS/TS/Python-файл или neurocenter.tool.json.');\n   if(/(?:^|\\/)(?:\\.git|node_modules|\\.npmrc|\\.yarnrc(?:\\.yml)?|\\.env(?:\\..*)?|id_rsa|id_ed25519)(?:\\/|$)/i.test(file))throw new Error('Файл в ссылке blob содержит секретный или служебный путь.');\n   if(subdirectory&&!file.startsWith(subdirectory+'/'))throw new Error('Папка subdirectory не содержит файл в ссылке blob.');\n   if(file.split('/').at(-1)===manifestName){\n    const directory=file.includes('/')?file.slice(0,file.lastIndexOf('/')):undefined;\n    if(subdirectory&&subdirectory!==directory)throw new Error('Папка subdirectory не совпадает с папкой рецепта в ссылке blob.');\n    subdirectory=directory;entrypoint=manifestName;\n   }else entrypoint=subdirectory?file.slice(subdirectory.length+1):file;\n   if(options.entrypoint!==undefined&&options.entrypoint!==''&&options.entrypoint!==entrypoint)throw new Error('Файл entrypoint не совпадает с файлом в ссылке blob.');\n  }\n  ref=treeRef;\n }\n return {url:`https://github.com/${owner.toLowerCase()}/${repository.toLowerCase()}`,owner:owner.toLowerCase(),repository:repository.toLowerCase(),...(ref?{ref}:{}),...(subdirectory?{subdirectory}:{}),...(entrypoint?{entrypoint}:{}),...(release?{release}:{})};\n}\n\n/** Builder принимает только полный commit; HTTP-форма может передать ветку до разрешения через GitHub. */\nfunction validateRepositorySource(value,{pinned=true}={}){\n if(!exact(value,pinned?['type','url','commit','subdirectory','entrypoint','runtimeSource','manifestSha256','release','snapshotSha256']:['type','url','ref','subdirectory','entrypoint','release'])||value.type!=='repository')throw new Error('Источник repository содержит неподдерживаемые поля.');\n const parsed=parseRepositoryUrl(value.url,pinned?{subdirectory:value.subdirectory,entrypoint:value.entrypoint}:{ref:value.ref,subdirectory:value.subdirectory,entrypoint:value.entrypoint});\n const release=value.release?validateReleaseInput(value.release):parsed.release;\n if(value.release&&parsed.release&&(release.tag!==parsed.release.tag||parsed.release.asset&&release.asset!==parsed.release.asset))throw new Error('Поля релиза не совпадают со ссылкой.');\n const selected=value.entrypoint===undefined||value.entrypoint===''?parsed.entrypoint:value.entrypoint;\n const entrypoint=!pinned&&(selected===undefined||selected==='')?undefined:relativePath(selected,'Файл запуска');\n if(entrypoint&&/\\.d\\.[cm]?ts$/i.test(entrypoint))throw new Error('Нужен исполняемый JS/TS-файл, без деклараций типов.');\n if(pinned&&!value.snapshotSha256&&!release&&entrypoint&&!/(?:^|\\/)SKILL\\.md$/.test(entrypoint)&&entrypoint!==manifestName&&!isSourceEntrypoint(entrypoint))throw new Error('Репозиторий должен содержать исполняемый JS/TS-файл запуска, SKILL.md или neurocenter.tool.json, без деклараций типов.');\n if(pinned){\n  if(typeof value.commit!=='string'||!commitPattern.test(value.commit))throw new Error('Репозиторий должен быть закреплён полным SHA commit (40 или 64 hex).');\n  if(release){\n   if(!release.id||!release.assetId||!release.sha256||!release.asset||!entrypoint||value.manifestSha256!==undefined||!value.runtimeSource)throw new Error('Релиз требует закреплённые id, SHA-256 и сгенерированную поставку.');\n   const runtimeSource=validateRuntimeSource(value.runtimeSource);\n   for(const bundle of Object.values(runtimeSource.assets))for(const asset of [bundle.app,...(!runtimeSource.python&&bundle.runtime?[bundle.runtime]:[])]){\n    const expected=`${parsed.url}/releases/download/${encodeURIComponent(release.tag)}/${encodeURIComponent(release.asset)}`;\n    if(asset.url!==expected||asset.sha256!==release.sha256)throw new Error('Поставка не совпадает с закреплённым файлом релиза.');\n   }\n   return {type:'repository',url:parsed.url,commit:value.commit.toLowerCase(),entrypoint,release,runtimeSource};\n  }\n  if(value.snapshotSha256!==undefined){\n   if(!/^[a-f0-9]{64}$/.test(value.snapshotSha256)||value.manifestSha256!==undefined||!value.runtimeSource)throw new Error('Сгенерированная поставка требует SHA-256 снимка и runtime.');\n   const runtimeSource=validateRuntimeSource(value.runtimeSource);\n   for(const bundle of Object.values(runtimeSource.assets)){\n    if(bundle.app.directory!=='.'||!runtimeSource.python&&bundle.runtime&&bundle.runtime.directory!=='.'||runtimeSource.python&&(!bundle.runtime?.url||bundle.runtime.directory!==undefined))throw new Error('Сгенерированная поставка должна использовать закреплённую папку репозитория и готовый либо закреплённый Python runtime.');\n   }\n   return {type:'repository',url:parsed.url,commit:value.commit.toLowerCase(),...(parsed.subdirectory?{subdirectory:parsed.subdirectory}:{}),entrypoint,runtimeSource,snapshotSha256:value.snapshotSha256};\n  }\n  const manifest=entrypoint===manifestName;\n  if(manifest?typeof value.manifestSha256!=='string'||!/^[a-f0-9]{64}$/.test(value.manifestSha256)||!value.runtimeSource:value.runtimeSource!==undefined||value.manifestSha256!==undefined)throw new Error('Источник manifest требует runtimeSource и SHA-256; у JS/TS-источника эти поля запрещены.');\n  return {type:'repository',url:parsed.url,commit:value.commit.toLowerCase(),...(parsed.subdirectory?{subdirectory:parsed.subdirectory}:{}),entrypoint,\n   ...(manifest?{runtimeSource:validateRuntimeSource(value.runtimeSource),manifestSha256:value.manifestSha256}:{})};\n }\n return {type:'repository',url:parsed.url,...(parsed.ref?{ref:parsed.ref}:{}),...(parsed.subdirectory?{subdirectory:parsed.subdirectory}:{}),...(entrypoint?{entrypoint}:{}),...(release?{release}:{})};\n}\n\nasync function githubJson(fetcher,pathname,{optional=false}={}){\n let response;\n try{response=await fetcher('https://api.github.com'+pathname,{redirect:'error',headers:{Accept:'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28','User-Agent':'Neurocenter-Catalog'},signal:AbortSignal.timeout(20000)});}\n catch{throw new Error('GitHub недоступен. Повторите проверку репозитория.');}\n if(response.status===404&&optional)return undefined;\n if(!response.ok)throw new Error(response.status===403||response.status===429?'GitHub временно ограничил запросы. Повторите позже.':'Публичный репозиторий, ветка или файл не найдены. Для ветки со слешем уточните ref.');\n const reader=response.body?.getReader();if(!reader)throw new Error('GitHub вернул пустой ответ.');\n const chunks=[];let bytes=0;\n try{while(true){const part=await reader.read();if(part.done)break;bytes+=part.value.length;if(bytes>2*1024*1024){await reader.cancel().catch(()=>undefined);throw new Error('Описание GitHub превышает допустимый размер.');}chunks.push(part.value);}}\n catch(error){if(error?.message==='Описание GitHub превышает допустимый размер.')throw error;throw new Error('Загрузка описания GitHub оборвалась. Повторите проверку.');}\n finally{reader.releaseLock();}\n try{return JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{throw new Error('GitHub вернул некорректный JSON.');}\n}\nfunction githubFileBytes(value,label,limit=65536){\n if(!object(value)||value.type!=='file'||value.encoding!=='base64'||!Number.isSafeInteger(value.size)||value.size<1||value.size>limit||typeof value.content!=='string'||value.content.length>Math.ceil(limit*1.4))throw new Error(label+' репозитория должен быть обычным файлом допустимого размера.');\n const normalized=value.content.replace(/\\n/g,'');\n const bytes=Buffer.from(normalized,'base64');\n if(bytes.toString('base64')!==normalized||bytes.length!==value.size||!Buffer.from(bytes.toString('utf8')).equals(bytes))throw new Error('GitHub вернул повреждённый '+label+'.');\n return bytes;\n}\nfunction decodePackage(value){\n const bytes=githubFileBytes(value,'package.json');\n try{const metadata=JSON.parse(bytes.toString('utf8'));if(!object(metadata))throw new Error();return metadata;}catch{throw new Error('package.json репозитория содержит некорректный JSON.');}\n}\n\n/** Одну и ту же строгую декларацию проверяют GitHub resolver и сборщик закреплённого архива. */\nfunction validateRepositoryManifest(value){\n if(typeof value!=='string'&&!Buffer.isBuffer(value))throw new Error(manifestName+' должен содержать UTF-8 JSON.');\n const bytes=Buffer.isBuffer(value)?value:Buffer.from(value,'utf8');\n if(!bytes.length||bytes.length>65536||!Buffer.from(bytes.toString('utf8')).equals(bytes))throw new Error(manifestName+' должен содержать UTF-8 JSON до 64 КиБ.');\n let manifest;try{manifest=JSON.parse(bytes.toString('utf8'));}catch{throw new Error(manifestName+' содержит некорректный JSON.');}\n if(!exact(manifest,['schemaVersion','name','description','source'])||manifest.schemaVersion!==1)throw new Error(manifestName+' требует schemaVersion: 1, source и только известные поля.');\n if(manifest.name!==undefined&&(typeof manifest.name!=='string'||!manifest.name.trim()||manifest.name.length>128||/[\\x00-\\x1f\\x7f]/.test(manifest.name)))throw new Error('Название в '+manifestName+' должно содержать до 128 символов.');\n if(manifest.description!==undefined&&(typeof manifest.description!=='string'||manifest.description.length>2000||/[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]/.test(manifest.description)))throw new Error('Описание в '+manifestName+' должно содержать до 2000 символов.');\n return {schemaVersion:1,...(manifest.name!==undefined?{name:manifest.name.trim()}:{}),...(manifest.description!==undefined?{description:manifest.description.trim()}:{}),source:validateRuntimeSource(manifest.source)};\n}\n\n/** Все чтения после commits/{ref} используют только полученный SHA; URL загрузки из API не исполняется. */\nasync function resolveRepositorySource(input,{fetch:fetcher=globalThis.fetch,metadata:includeMetadata=true,inspectAsset,inspectRepository,inspectSkill}={}){\n const source=validateRepositorySource({type:'repository',...input},{pinned:false});\n const parsed=parseRepositoryUrl(source.url),base=`/repos/${encodeURIComponent(parsed.owner)}/${encodeURIComponent(parsed.repository)}`;\n const repository=await githubJson(fetcher,base);\n if(!object(repository)||repository.private!==false||typeof repository.default_branch!=='string')throw new Error('Поддерживаются только публичные репозитории GitHub.');\n if(source.release)return resolveGithubRelease({source,parsed,repository,base,githubJson,fetcher,inspectAsset});\n const ref=source.ref??reference(repository.default_branch);\n const resolved=await githubJson(fetcher,base+'/commits/'+encodeURIComponent(ref));\n if(!object(resolved)||typeof resolved.sha!=='string'||!commitPattern.test(resolved.sha))throw new Error('GitHub не подтвердил полный SHA commit.');\n const commit=resolved.sha.toLowerCase(),prefix=source.subdirectory?source.subdirectory+'/':'';\n const contentsPath=relative=>{const file=(prefix+relative).replace(/\\/$/,'');return base+'/contents'+(file?'/'+file.split('/').map(encodeURIComponent).join('/'):'')+'?ref='+commit;};\n const result=(entrypoint,candidates,metadata={})=>({url:source.url,commit,ref,...(source.subdirectory?{subdirectory:source.subdirectory}:{}),entrypoint,candidates,\n  name:typeof metadata.name==='string'?metadata.name.slice(0,128):typeof repository.name==='string'?repository.name:parsed.repository,\n  description:typeof metadata.description==='string'?metadata.description.slice(0,2000):typeof repository.description==='string'?repository.description.slice(0,2000):'',\n  ...(object(metadata.dependencies)&&metadata.dependencies['@opencode-ai/plugin']?{recommendedKind:'plugin'}:\n   object(metadata.dependencies)&&metadata.dependencies['@modelcontextprotocol/sdk']?{recommendedKind:'mcp'}:{})});\n const manifestResult=entry=>{\n  const bytes=githubFileBytes(entry,manifestName),manifest=validateRepositoryManifest(bytes);\n  return {...result(manifestName,[manifestName],manifest),recommendedKind:'mcp',adapter:manifest.source.adapter,\n   supportedTargets:runtimeSourceTargets(manifest.source),runtimeSource:manifest.source,manifestSha256:createHash('sha256').update(bytes).digest('hex')};\n };\n const skillResult=async()=>{\n  if(typeof inspectSkill!=='function')throw new Error('Проверка SKILL.md недоступна.');\n  const entrypoint=source.entrypoint??'SKILL.md';\n  const content=githubFileBytes(await githubJson(fetcher,contentsPath(entrypoint)),'SKILL.md',1048576).toString('utf8');\n  const metadata=inspectSkill([{path:entrypoint,content}]);\n  return {...result(entrypoint,[entrypoint],metadata),recommendedKind:'skill',runnableKinds:['skill'],warnings:[]};\n };\n if(isPreparedRagRepository({...source,commit})){\n  const prepared=RAG_PLUGIN_SOURCE;\n  const entry=await githubJson(fetcher,contentsPath(prepared.entrypoint),{optional:true});\n  if(!object(entry)||entry.type!=='file'||!Number.isSafeInteger(entry.size)||entry.size<1||entry.size>1048576)throw new Error('Файл плагина OpenCodeRAG отсутствует в закреплённом commit.');\n  return {...result(prepared.entrypoint,[prepared.entrypoint],{name:'OpenCodeRAG (плагин)',description:'Плагин OpenCodeRAG от MrDoe: инструменты поиска, hooks и автоматическое индексирование. Совместимая сборка для OpenCode 1.x без интерфейса TUI OpenCode V2.'}),\n   recommendedKind:'plugin',preparedAdapter:prepared.adapter,preparedVersion:prepared.version,supportedTargets:[...prepared.supportedTargets]};\n }\n if(source.entrypoint===manifestName)return manifestResult(await githubJson(fetcher,contentsPath(manifestName)));\n if(source.entrypoint&&/(?:^|\\/)SKILL\\.md$/.test(source.entrypoint))return skillResult();\n if(source.entrypoint&&!isSourceEntrypoint(source.entrypoint)&&source.entrypoint!==manifestName){\n  if(typeof inspectRepository!=='function')throw new Error('Проверка готовой поставки репозитория недоступна.');\n  return {...result('',[]),...await inspectRepository({type:'repository',url:source.url,commit,...(source.subdirectory?{subdirectory:source.subdirectory}:{})},source.entrypoint)};\n }\n if(source.entrypoint&&!includeMetadata){\n  const entry=await githubJson(fetcher,contentsPath(source.entrypoint),{optional:true});\n  if(!object(entry)||entry.type!=='file'||!Number.isSafeInteger(entry.size)||entry.size<1||entry.size>1048576)throw new Error('Файл запуска не найден в закреплённом commit или является ссылкой.');\n  return result(source.entrypoint,[source.entrypoint]);\n }\n const directory=await githubJson(fetcher,contentsPath(''));\n if(!Array.isArray(directory)||directory.length>1000)throw new Error('Папка репозитория недоступна или слишком велика для просмотра.');\n const listings=new Map(directory.filter(object).map(entry=>[entry.name,entry]));\n const knownEntries=new Map(directory.filter(object).map(entry=>[entry.name,entry]));\n if(!source.entrypoint&&listings.has(manifestName))return manifestResult(await githubJson(fetcher,contentsPath(manifestName)));\n if(!source.entrypoint&&listings.has('SKILL.md'))return skillResult();\n const packageEntry=listings.get('package.json');\n const metadata=packageEntry?decodePackage(await githubJson(fetcher,contentsPath('package.json'))):{};\n const detected=packageEntrypoints(metadata),pluginExport=detected.recommendedKind==='plugin'&&detected.runnableKinds.includes('plugin');\n const candidates=[];\n const add=value=>{if(typeof value!=='string')return;try{const entry=relativePath(value.replace(/^\\.\\//,''),'Файл запуска');if(isSourceEntrypoint(entry)&&!candidates.includes(entry))candidates.push(entry);}catch{}};\n const bins=(pluginExport?[]:typeof metadata.bin==='string'?[metadata.bin]:object(metadata.bin)?Object.values(metadata.bin):[]).filter(value=>typeof value==='string'&&isSourceEntrypoint(value));\n for(const value of pluginExport?detected.candidates:bins.length?bins:[metadata.main,metadata.module,metadata.source])add(value);\n const exports=object(metadata.exports)&&metadata.exports['.']!==undefined?metadata.exports['.']:metadata.exports;\n if(!pluginExport&&!bins.length&&typeof exports==='string')add(exports);else if(!pluginExport&&!bins.length&&object(exports))for(const key of ['import','default','node','require']){const value=exports[key];if(typeof value==='string')add(value);else if(object(value))for(const nested of ['import','default','require'])add(value[nested]);}\n for(const baseName of ['index','main','plugin','server'])for(const suffix of SOURCE_EXTENSIONS){if(!bins.length&&listings.get(baseName+'.'+suffix)?.type==='file')add(baseName+'.'+suffix);}\n const src=listings.get('src');\n if(src?.type==='dir'){\n  const nested=await githubJson(fetcher,contentsPath('src'),{optional:true});\n  if(Array.isArray(nested)&&nested.length<=1000){\n   for(const entry of nested.filter(object))knownEntries.set('src/'+entry.name,entry);\n   for(const baseName of ['index','main','plugin','server'])for(const suffix of SOURCE_EXTENSIONS){if(!bins.length&&nested.some(entry=>entry?.name===baseName+'.'+suffix&&entry.type==='file'))add('src/'+baseName+'.'+suffix);}\n  }\n }\n const wanted=source.entrypoint?[source.entrypoint,...candidates.filter(value=>value!==source.entrypoint)]:candidates;\n const verified=[];\n for(const candidate of wanted.slice(0,12)){\n  const file=knownEntries.has(candidate)?knownEntries.get(candidate):await githubJson(fetcher,contentsPath(candidate),{optional:true});\n  if(object(file)&&file.type==='file'&&Number.isSafeInteger(file.size)&&file.size>0&&file.size<=1048576)verified.push(candidate);\n  else if(source.entrypoint===candidate)throw new Error('Файл запуска не найден в закреплённом commit или является ссылкой.');\n }\n // Published exports win when present; source-only repositories may still need src/index.ts.\n const preferred=pluginExport&&!source.entrypoint?verified.filter(candidate=>detected.candidates.includes(candidate)):[];\n const selected=preferred.length?preferred:verified;\n const entrypoint=source.entrypoint??(selected.length===1?selected[0]:'');\n if(!verified.length){\n  if(typeof inspectRepository==='function')return {...result('',[],metadata),...await inspectRepository({type:'repository',url:source.url,commit,...(source.subdirectory?{subdirectory:source.subdirectory}:{})})};\n  throw new Error('В репозитории не найден JS/TS-файл запуска. Уточните папку проекта и entrypoint.');\n }\n return {...result(entrypoint,selected,metadata),...(detected.recommendedKind?{recommendedKind:detected.recommendedKind}:{}),requiresEntrypointChoice:selected.length>1&&!source.entrypoint,runnableKinds:detected.runnableKinds,warnings:detected.runnableKinds.length?[]:['Не найдены команда запуска MCP или признаки плагина OpenCode. Обычный библиотечный export не является MCP.']};\n}\n\nmodule.exports={parseRepositoryUrl,validateRepositorySource,validateRepositoryManifest,normalizeRepositorySource:validateRepositorySource,resolveRepositorySource};\n"
