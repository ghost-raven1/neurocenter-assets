      "path": "services/shared/runtime-artifacts.cjs",
      "content": "'use strict';\nconst {createHash}=require('node:crypto');\nconst {mkdir,open,chmod}=require('node:fs/promises');\nconst {createGunzip}=require('node:zlib');\nconst path=require('node:path');\nconst TARGETS=['darwin-arm64','darwin-x64','linux-arm64-glibc','linux-x64-glibc','linux-arm64-musl','linux-x64-musl','win32-arm64','win32-x64'];\nconst LIMITS={compressedBytes:256*1024**2,unpackedBytes:1024**3,filesCount:20000,cacheBytes:2*1024**3};\nconst ordinal=(a,b)=>a===b?0:a<b?-1:1;\nfunction portablePath(value){return typeof value==='string'&&value.length>0&&Buffer.byteLength(value)<=240&&!value.includes('\\\\')&&!value.startsWith('/')&&value.split('/').every(part=>part&&part!=='.'&&part!=='..'&&!/[<>:\"|?*\\x00-\\x1f\\x7f]/.test(part)&&!/[. ]$/.test(part)&&!/^(con|prn|aux|nul|com\\d|lpt\\d)(\\.|$)/i.test(part));}\n/** Одобрение закрепляет только точные переносимые артефакты, без URL и install hooks. */\nfunction normalizeRuntimeArtifacts(value){\n if(value===undefined)return [];\n if(!Array.isArray(value)||value.length<1||value.length>8)throw new Error('Укажите от 1 до 8 готовых платформенных артефактов.');\n const seen=new Set();return value.map(item=>{\n  if(!item||typeof item!=='object'||Array.isArray(item)||Object.keys(item).some(key=>!['target','sha256','compressedBytes','unpackedBytes','filesCount','entrypoint','executable'].includes(key))||!TARGETS.includes(item.target)||seen.has(item.target)||!/^[a-f0-9]{64}$/.test(item.sha256)||!portablePath(item.entrypoint)||item.executable!==undefined&&typeof item.executable!=='boolean'||!['compressedBytes','unpackedBytes','filesCount'].every(key=>Number.isSafeInteger(item[key])&&item[key]>0&&item[key]<=LIMITS[key]))throw new Error('Некорректный или повторяющийся платформенный артефакт.');\n  seen.add(item.target);return {...item};\n }).sort((a,b)=>ordinal(a.target,b.target));\n}\n/** Плагин OpenCode импортируется как JS-модуль и не может быть нативной командой. */\nfunction validateRuntimeArtifactEntrypoints(kind,artifacts){\n if(kind==='plugin'&&artifacts.some(item=>item.executable===true||!/\\.(?:js|mjs|cjs)$/.test(item.entrypoint)))throw new Error('Готовому плагину нужна точка входа .js, .mjs или .cjs без нативного запуска.');\n}\nfunction text(buffer){const end=buffer.indexOf(0);const bytes=end<0?buffer:buffer.subarray(0,end);const value=bytes.toString('utf8');if(!Buffer.from(value).equals(bytes))throw new Error('Путь архива должен быть UTF-8.');if(end>=0&&buffer.subarray(end).some(byte=>byte!==0))throw new Error('Неоднозначное поле архива.');return value;}\nfunction octal(buffer){const value=buffer.toString('ascii').replace(/\\0.*$/,'').trim();if(!/^[0-7]+$/.test(value))throw new Error('Неподдерживаемое число в TAR.');const result=parseInt(value,8);if(!Number.isSafeInteger(result))throw new Error('Слишком большое число в TAR.');return result;}\n/** Разбирает только обычный USTAR: никаких ссылок, PAX, устройств или исполнения кода. */\nasync function inspectRuntimeArchive(filename,descriptor,{destination}={}){\n normalizeRuntimeArtifacts([descriptor]);const archive=await open(filename,require('node:fs').constants.O_RDONLY|require('node:fs').constants.O_NOFOLLOW|require('node:fs').constants.O_NONBLOCK);\n try{\n  const before=await archive.stat();if(!before.isFile()||before.nlink!==1||before.size!==descriptor.compressedBytes)throw new Error('Размер архива не совпадает с одобренным.');\n  const compressed=createHash('sha256');let compressedRead=0;for await(const chunk of archive.createReadStream({autoClose:false})){compressedRead+=chunk.length;if(compressedRead>descriptor.compressedBytes)throw new Error('Архив изменился во время проверки.');compressed.update(chunk);}if(compressed.digest('hex')!==descriptor.sha256)throw new Error('SHA-256 архива не совпадает с одобренным.');\n  const input=archive.createReadStream({autoClose:false,start:0});const unzip=createGunzip();input.on('error',error=>unzip.destroy(error));input.pipe(unzip);const iterator=unzip[Symbol.asyncIterator]();let pending=Buffer.alloc(0),done=false,expanded=0;\n  const read=async(size,allowEnd=false)=>{while(pending.length<size&&!done){const next=await iterator.next();done=!!next.done;if(!done){expanded+=next.value.length;if(expanded>LIMITS.unpackedBytes+LIMITS.filesCount*1536+1024*1024)throw new Error('Распакованный архив превышает предел.');pending=Buffer.concat([pending,next.value]);}}if(pending.length<size){if(allowEnd&&pending.length===0)return null;throw new Error('Архив оборван.');}const result=pending.subarray(0,size);pending=pending.subarray(size);return result;};\n  const entries=[],names=new Map(),ancestors=new Set();let total=0,zeroes=0,headers=0;\n  try{while(true){const header=await read(512,true);if(!header)break;if(header.every(byte=>byte===0)){zeroes++;if(zeroes>2048)throw new Error('Слишком длинное окончание TAR.');continue;}if(zeroes)throw new Error('Данные после окончания TAR.');if(++headers>LIMITS.filesCount*2)throw new Error('Слишком много записей TAR.');\n   const checksum=octal(header.subarray(148,156));let sum=0;for(let index=0;index<512;index++)sum+=index>=148&&index<156?32:header[index];if(sum!==checksum)throw new Error('Повреждён заголовок TAR.');\n   const magic=header.subarray(257,263).toString('ascii');if(magic!=='ustar\\0'&&magic!=='ustar ')throw new Error('Требуется обычный архив USTAR.');\n   const type=header[156];if(![0,48,53].includes(type)||header.subarray(157,257).some(byte=>byte!==0))throw new Error('Ссылки и специальные записи TAR запрещены.');\n   const prefix=text(header.subarray(345,500));const name=text(header.subarray(0,100));const relative=(prefix?prefix+'/':'')+name;const normalized=type===53?relative.replace(/\\/$/,''):relative;\n   if(!portablePath(normalized))throw new Error('Недопустимый путь в архиве.');const key=normalized.normalize('NFC').toLowerCase();const parents=key.split('/').slice(0,-1).map((_part,index,parts)=>parts.slice(0,index+1).join('/'));if(names.has(key)||type!==53&&ancestors.has(key)||parents.some(parent=>names.has(parent)&&names.get(parent)!=='directory'))throw new Error('Повтор или конфликт путей в архиве.');names.set(key,type===53?'directory':'file');for(const parent of parents)ancestors.add(parent);\n   const size=octal(header.subarray(124,136));const mode=octal(header.subarray(100,108));if(mode&0o7000||type===53&&size!==0)throw new Error('Недопустимые права или размер TAR.');\n   if(type===53){if(destination)await mkdir(path.join(destination,normalized),{recursive:true,mode:0o700});continue;}\n   total+=size;if(total>descriptor.unpackedBytes||entries.length>=descriptor.filesCount)throw new Error('Архив превышает одобренный размер или число файлов.');const digest=createHash('sha256');let handle;\n   if(destination){const target=path.join(destination,normalized);await mkdir(path.dirname(target),{recursive:true,mode:0o700});handle=await open(target,'wx',0o600);}\n   try{let remaining=size;while(remaining){const chunk=await read(Math.min(remaining,64*1024));digest.update(chunk);if(handle)await handle.writeFile(chunk);remaining-=chunk.length;}if(handle)await handle.sync();}finally{await handle?.close();}\n   const padding=(512-size%512)%512;if(padding&&(await read(padding)).some(byte=>byte!==0))throw new Error('Некорректное выравнивание TAR.');\n   const executable=!!(mode&0o111);if(destination)await chmod(path.join(destination,normalized),executable?0o500:0o400);entries.push({path:normalized,size,sha256:digest.digest('hex'),executable});\n  }\n  if(zeroes<2||total!==descriptor.unpackedBytes||entries.length!==descriptor.filesCount)throw new Error('Опись архива не совпадает с одобренной.');\n  const entry=entries.find(item=>item.path===descriptor.entrypoint);if(!entry||descriptor.executable&&!entry.executable)throw new Error('Точка входа отсутствует или не исполняемая.');\n  const after=await archive.stat();if(before.ino!==after.ino||before.size!==after.size||before.mtimeMs!==after.mtimeMs||after.nlink!==1)throw new Error('Архив изменился во время проверки.');return entries.sort((a,b)=>ordinal(a.path,b.path));\n  }finally{input.destroy();unzip.destroy();}\n }finally{await archive.close();}\n}\nmodule.exports={TARGETS,LIMITS,portablePath,normalizeRuntimeArtifacts,validateRuntimeArtifactEntrypoints,inspectRuntimeArchive};\n"
    },
    {
      "path": "services/shared/runtime-artifacts.d.cts",
      "content": "export interface RuntimeArtifact {target:string;sha256:string;compressedBytes:number;unpackedBytes:number;filesCount:number;entrypoint:string;executable?:boolean}\nexport interface RuntimeArtifactEntry {path:string;size:number;sha256:string;executable:boolean}\nexport const TARGETS:string[];\nexport const LIMITS:{compressedBytes:number;unpackedBytes:number;filesCount:number;cacheBytes:number};\nexport function portablePath(value:unknown):boolean;\nexport function normalizeRuntimeArtifacts(value:unknown):RuntimeArtifact[];\n/** Плагин допускает только импортируемую JS-точку входа. */\nexport function validateRuntimeArtifactEntrypoints(kind:string,artifacts:RuntimeArtifact[]):void;\nexport function inspectRuntimeArchive(filename:string,descriptor:RuntimeArtifact,options?:{destination?:string}):Promise<RuntimeArtifactEntry[]>;\n"
    },
    {
      "path": "services/shared/skill-source.mjs",
      "content": "const object=value=>!!value&&typeof value==='object'&&!Array.isArray(value);\nconst bytes=value=>new TextEncoder().encode(value).length;\nconst fileBytes=file=>{\n if(file.encoding===undefined)return bytes(file.content);\n if(file.encoding!=='base64'||typeof file.content!=='string'||file.content.length>4*Math.ceil(1024**2/3)||file.content.length%4||/[^A-Za-z0-9+/=]/.test(file.content))throw new Error('Ресурс скилла должен содержать канонический base64.');\n let decoded;try{decoded=atob(file.content);}catch{throw new Error('Ресурс скилла должен содержать канонический base64.');}\n if(btoa(decoded)!==file.content)throw new Error('Ресурс скилла должен содержать канонический base64.');return decoded.length;\n};\nconst forbidden=/(?:^|\\/)(?:\\.git|node_modules|\\.npmrc|\\.yarnrc(?:\\.yml)?|\\.env(?:\\..*)?|id_rsa|id_ed25519)(?:\\/|$)|\\.(?:pem|key|p12|pfx)$/i;\n\n/** Candidate discovery never flattens a skill tree or silently chooses among several instructions. */\nexport function skillSourceEntrypoints(files){\n return Array.isArray(files)?files.filter(file=>typeof file?.path==='string'&&/(?:^|\\/)SKILL\\.md$/.test(file.path)).map(file=>file.path).sort():[];\n}\n/** Match the bridge preflight: local Markdown links must remain inside this exact delivered skill. */\nexport function validateSkillLinks(content,paths){\n const files=new Set(paths);\n for(const link of content.matchAll(/!?\\[[^\\]]*\\]\\(<?([^\\s)>]+)>?(?:\\s+[^)]*)?\\)/g)){\n  const raw=link[1]??'';\n  if(!raw||raw.startsWith('#')||/^(?:https?|mailto):/i.test(raw))continue;\n  if(/^[a-z][a-z0-9+.-]*:/i.test(raw))throw new Error('Скилл содержит запрещённую локальную ссылку.');\n  let target;try{target=decodeURIComponent(raw.split(/[?#]/)[0]??'');}catch{throw new Error('Скилл содержит некорректное кодирование ссылки.');}\n  if(target.startsWith('/')||target.includes('\\\\'))throw new Error('Локальная ссылка скилла выходит из его папки.');\n  const parts=[];for(const part of target.split('/')){if(!part||part==='.')continue;if(part==='..'){if(!parts.length)throw new Error('Локальная ссылка скилла выходит из его папки.');parts.pop();}else parts.push(part);}\n  if(!files.has(parts.join('/')))throw new Error('В скилле отсутствует файл локальной ссылки: '+target);\n }\n}\n\n/** One portable SKILL.md tree becomes the same inline native skill on server and in preview. */\nexport function parseSkillSource(files,overrides={},parseYaml){\n if(!Array.isArray(files)||!files.length||files.length>100)throw new Error('Скилл: от 1 до 100 текстовых файлов.');\n const seen=new Set();let total=0;\n for(const file of files){\n  const name=file?.path;\n  if(!object(file)||Object.keys(file).some(key=>!['path','content','encoding'].includes(key)))throw new Error('Ресурс скилла содержит неподдерживаемые поля.');\n  if(typeof name!=='string'||!name||name.length>240||name!==name.trim()||name.startsWith('/')||name.includes('\\\\')||/[\\x00-\\x1f\\x7f<>:\"|?*]/.test(name)\n   ||name.split('/').some(part=>!part||part==='.'||part==='..'||/[. ]$/.test(part)||/^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)/i.test(part))||forbidden.test(name))throw new Error('Недопустимый или секретный путь ресурса скилла.');\n  const lower=name.normalize('NFC').toLowerCase();\n  if(seen.has(lower)||[...seen].some(other=>other.startsWith(lower+'/')||lower.startsWith(other+'/')))throw new Error('Пути ресурсов скилла конфликтуют.');\n  seen.add(lower);\n  if(typeof file.content!=='string'||file.content.includes('\\0')||fileBytes(file)>1024**2)throw new Error('Ресурс скилла превышает 1 МиБ или имеет некорректное кодирование.');\n  total+=fileBytes(file);if(total>5*1024**2)throw new Error('Скилл превышает 5 МиБ.');\n }\n const candidates=skillSourceEntrypoints(files),entrypoint=overrides.entrypoint??(candidates.length===1?candidates[0]:undefined);\n if(!entrypoint||!candidates.includes(entrypoint))throw new Error(candidates.length>1?'Найдено несколько SKILL.md. Выберите скилл для упаковки.':'В выбранных исходниках нужен файл SKILL.md.');\n const prefix=entrypoint.slice(0,-'SKILL.md'.length),selected=files.filter(file=>file.path.startsWith(prefix)).map(file=>({...file,path:file.path.slice(prefix.length)}));\n const instruction=selected.find(file=>file.path==='SKILL.md');\n if(instruction.encoding!==undefined)throw new Error('Инструкция SKILL.md должна быть текстом UTF-8.');\n if(selected.some(file=>file.path!=='SKILL.md'&&!/^(scripts|references|assets)\\//.test(file.path)&&!/^(?:readme|licen[cs]e|notice)(?:\\.[a-z0-9._-]+)?$/i.test(file.path)))throw new Error('Ресурсы скилла разместите в scripts/, references/ или assets/.');\n const normalized=instruction.content.replace(/^\\uFEFF/,'').replace(/\\r\\n/g,'\\n');\n let meta={},body=normalized;\n if(normalized.startsWith('---\\n')){\n  const close=normalized.indexOf('\\n---',4);\n  if(close<0||!/^\\n---(?:\\n|$)/.test(normalized.slice(close)))throw new Error('В SKILL.md не закрыт YAML frontmatter.');\n  if(typeof parseYaml!=='function')throw new Error('Разбор YAML скилла недоступен.');\n  try{meta=parseYaml(normalized.slice(4,close));}catch{throw new Error('SKILL.md содержит некорректный YAML frontmatter.');}\n  if(!object(meta))throw new Error('Frontmatter SKILL.md должен быть объектом.');\n  body=normalized.slice(close+4).replace(/^\\n/,'');\n }\n if(!body.trim())throw new Error('Инструкция SKILL.md пуста.');\n const slug=meta.slug??meta.name;\n if(typeof slug!=='string'||slug.length>64||!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug))throw new Error('В frontmatter SKILL.md нужен name или slug: до 64 латинских букв, цифр и одиночных дефисов.');\n const name=(overrides.name??meta.name??slug),rawDescription=overrides.description??meta.description;\n const description=typeof rawDescription==='string'?rawDescription.trim().replace(/[\\r\\n\\t]+/g,' ').replace(/ {2,}/g,' '):rawDescription;\n if(typeof name!=='string'||!name.trim()||name.trim().length>128||/[\\x00-\\x1f\\x7f]/.test(name))throw new Error('Название скилла: до 128 символов.');\n if(typeof description!=='string'||!description.trim()||description.length>1024||/[\\x00-\\x1f\\x7f]/.test(description))throw new Error('Для скилла нужно описание до 1024 символов.');\n for(const key of ['mcp','plugins','dependencies'])if(meta[key]!==undefined&&(!Array.isArray(meta[key])||meta[key].length))throw new Error('Скилл с зависимостями добавляется через каталог ассетов с точными связанными версиями.');\n if(meta.tags!==undefined&&(!Array.isArray(meta.tags)||meta.tags.length>20||meta.tags.some(tag=>typeof tag!=='string'||!tag.trim()||tag.length>128||/[\\x00-\\x1f]/.test(tag))))throw new Error('Теги скилла: до 20 непустых строк.');\n if(meta.specialization!==undefined&&(typeof meta.specialization!=='string'||meta.specialization.length>256))throw new Error('Специализация скилла: до 256 символов.');\n const resources=selected.filter(file=>/^(scripts|references|assets)\\//.test(file.path)).map(({path,content,encoding})=>({path:path.normalize('NFC'),content,...(encoding?{encoding}:{})})).sort((a,b)=>a.path<b.path?-1:a.path>b.path?1:0);\n if(resources.some(file=>file.path.length>200||bytes(file.path)>240))throw new Error('Путь ресурса скилла превышает допустимый размер.');\n if(resources.reduce((sum,file)=>sum+fileBytes(file),0)>4*1024**2)throw new Error('Ресурсы скилла превышают 4 МиБ.');\n if(bytes(`---\\nname: ${JSON.stringify(slug)}\\ndescription: ${JSON.stringify(description.trim())}\\nmcp: []\\nplugins: []\\n---\\n\\n${body}`)>1024**2)throw new Error('Инструкция SKILL.md вместе с метаданными превышает 1 МиБ.');\n if(!overrides.metadataOnly)validateSkillLinks(body,['SKILL.md',...resources.map(file=>file.path)]);\n return {entrypoint,slug,name:name.trim().normalize('NFC'),description:description.trim(),body,\n  meta:{description:description.trim(),tags:[...new Set((meta.tags??[]).map(tag=>tag.trim().normalize('NFC')))],mcp:[],plugins:[],...(meta.specialization?{specialization:meta.specialization}:{})},\n  resources};\n}\n"
    },
    {
      "path": "services/shared/source-candidates.cjs",
      "content": "'use strict';\nconst {isSourceEntrypoint}=require('./source-entrypoint.cjs');\nconst {portablePath}=require('./runtime-artifacts.cjs');\nconst object=value=>!!value&&typeof value==='object'&&!Array.isArray(value);\nconst clean=value=>typeof value==='string'&&portablePath(value.replace(/^\\.\\//,''))&&isSourceEntrypoint(value)?value.replace(/^\\.\\//,''):undefined;\n/** Node conditions describe alternatives for one export, not separate user commands. */\nfunction rootExport(value,depth=0){\n if(typeof value==='string')return clean(value);\n if(!value||depth>4)return;\n if(Array.isArray(value)){for(const item of value.slice(0,16)){const result=rootExport(item,depth+1);if(result)return result;}return;}\n if(!object(value))return;\n if(Object.hasOwn(value,'.'))return rootExport(value['.'],depth+1);\n for(const key of ['node','import','default','require']){const result=rootExport(value[key],depth+1);if(result)return result;}\n}\n/** Only bin is executable evidence for an otherwise ordinary library package. */\nfunction packageEntrypoints(metadata){\n const bins=typeof metadata.bin==='string'?[metadata.bin]:object(metadata.bin)?Object.values(metadata.bin):[];\n const executable=[...new Set(bins.map(clean).filter(Boolean))];\n const dependencies={...(object(metadata.dependencies)?metadata.dependencies:{}),...(object(metadata.peerDependencies)?metadata.peerDependencies:{}),...(object(metadata.devDependencies)?metadata.devDependencies:{})};\n const kind=dependencies['@opencode-ai/plugin']?'plugin':dependencies['@modelcontextprotocol/sdk']?'mcp':undefined;\n // A plugin can ship an installer CLI; OpenCode loads its package export instead of bin.\n const pluginEntry=kind==='plugin'&&(rootExport(metadata.exports)||clean(metadata.module)||clean(metadata.main)||clean(metadata.source));\n if(pluginEntry)return {candidates:[pluginEntry],runnableKinds:['plugin'],recommendedKind:'plugin'};\n const fallback=[clean(metadata.module),clean(metadata.main),rootExport(metadata.exports),clean(metadata.source)].filter(Boolean);\n const candidates=executable.length?executable:[...new Set(fallback)].slice(0,1);\n return {candidates,runnableKinds:executable.length?['mcp']:kind?[kind]:[],...(kind?{recommendedKind:kind}:{})};\n}\nmodule.exports={packageEntrypoints};\n"
    },
    {
      "path": "services/shared/source-entrypoint.cjs",
      "content": "'use strict';\n\nconst SOURCE_EXTENSIONS = Object.freeze(['ts', 'mts', 'cts', 'mjs', 'js', 'cjs', 'tsx']);\n\n/** Декларации типов не исполняются; исходники JS/TS проходят общий компилятор. */\nfunction isSourceEntrypoint(value) {\n return typeof value === 'string' && /\\.(?:[cm]?[jt]s|tsx)$/.test(value) && !/\\.d\\.[cm]?ts$/.test(value);\n}\n\nfunction isTypeScriptEntrypoint(value) {\n return isSourceEntrypoint(value) && /\\.(?:[cm]?ts|tsx)$/.test(value);\n}\n\nmodule.exports = {SOURCE_EXTENSIONS, isSourceEntrypoint, isTypeScriptEntrypoint};\n"
    },
    {
      "path": "services/shared/source-entrypoint.d.cts",
      "content": "export const SOURCE_EXTENSIONS: readonly string[];\nexport function isSourceEntrypoint(value: unknown): value is string;\nexport function isTypeScriptEntrypoint(value: unknown): value is string;\n"
    },
    {
      "path": "services/shared/tool-runtime-source.cjs",
      "content": "'use strict';\nconst {isIP,BlockList}=require('node:net');\nconst {portablePath,TARGETS}=require('./runtime-artifacts.cjs');\nconst {validatePythonPlan}=require('./python-source-plan.cjs');\nconst adapters=Object.freeze({python:'Python',java:'Java',dotnet:'.NET',go:'Go',rust:'Rust',native:'Нативная программа'});\nconst object=value=>!!value&&typeof value==='object'&&!Array.isArray(value);\nconst exact=(value,keys)=>object(value)&&Object.keys(value).every(key=>keys.includes(key));\nconst blocked=new BlockList();\nfor(const [address,prefix] of [['0.0.0.0',8],['10.0.0.0',8],['100.64.0.0',10],['127.0.0.0',8],['169.254.0.0',16],['172.16.0.0',12],['192.0.0.0',24],['192.0.2.0',24],['192.168.0.0',16],['198.18.0.0',15],['198.51.100.0',24],['203.0.113.0',24],['224.0.0.0',4],['240.0.0.0',4]])blocked.addSubnet(address,prefix,'ipv4');\nfor(const [address,prefix] of [['2001::',23],['2001:db8::',32],['2002::',16],['3fff::',20]])blocked.addSubnet(address,prefix,'ipv6');\nconst globalV6=new BlockList();globalV6.addSubnet('2000::',3,'ipv6');\n\n/** DNS-проверка применяется повторно к каждому адресу фактического HTTPS-соединения. */\nfunction isPublicRuntimeAddress(value){const family=isIP(value);return family===4?!blocked.check(value,'ipv4'):family===6&&globalV6.check(value,'ipv6')&&!blocked.check(value,'ipv6');}\nfunction assetUrl(value){\n if(typeof value!=='string'||value.length>4096||/[\\x00-\\x20\\x7f\\\\]/.test(value))throw new Error('Asset требует публичный HTTPS URL.');\n let url;try{url=new URL(value);}catch{throw new Error('Некорректный URL asset.');}\n const hostname=url.hostname.toLowerCase(),address=hostname.replace(/^\\[|\\]$/g,'');\n if(url.protocol!=='https:'||url.port||url.username||url.password||url.hash||!hostname.includes('.')||hostname.endsWith('.')||/(?:^|\\.)(?:localhost|local|internal|lan|home|test|invalid)$/.test(hostname)||isIP(address)&&!isPublicRuntimeAddress(address))throw new Error('Asset требует публичный HTTPS URL без пароля, локального адреса и нестандартного порта.');\n return url.href;\n}\nfunction relative(value,label){if(typeof value!=='string'||!portablePath(value)||value.split('/').some(part=>part.toLowerCase()==='.git'))throw new Error(label+': нужен переносимый относительный путь.');return value;}\nfunction asset(value,{local=false}={}){\n const directory=object(value)&&Object.hasOwn(value,'directory');\n if(!exact(value,directory&&local?['directory','entrypoint','executables']:['url','sha256','format','entrypoint','executables'])||directory&&!local)throw new Error('Asset содержит неподдерживаемые поля.');\n const entrypoint=relative(value.entrypoint,'Точка входа asset');\n if(/\\.(?:sh|bash|zsh|bat|cmd|ps1)$/i.test(entrypoint))throw new Error('Shell-скрипт не является автономной точкой входа.');\n const executables=value.executables;\n if(executables!==undefined&&(!Array.isArray(executables)||executables.length>20000||new Set(executables).size!==executables.length))throw new Error('executables должен содержать уникальные пути.');\n const result={...(directory?{directory:value.directory==='.'?'.':relative(value.directory,'Папка app')}:{url:assetUrl(value.url),sha256:value.sha256,format:value.format}),entrypoint,...(executables?{executables:executables.map(item=>relative(item,'Исполняемый файл'))}:{})};\n if(!directory&&(!/^[a-f0-9]{64}$/.test(value.sha256??'')||!['tar.gz','zip','file'].includes(value.format)))throw new Error('Remote asset требует SHA-256 и формат tar.gz, zip или file.');\n return result;\n}\n/** Декларация готового приложения и runtime не содержит команд установки или компиляции. */\nfunction validateRuntimeSource(value){\n if(!exact(value,['type','adapter','assets','python'])||value.type!=='runtime'||!Object.hasOwn(adapters,value.adapter)||!exact(value.assets,TARGETS)||!Object.keys(value.assets).length)throw new Error('runtime требует известный adapter и платформенные assets.');\n if(value.python!==undefined&&value.adapter!=='python')throw new Error('План Python разрешён только для adapter python.');\n const python=value.python===undefined?undefined:validatePythonPlan(value.python);\n const managed=['python','java','dotnet'].includes(value.adapter),assets={};\n for(const [target,bundle] of Object.entries(value.assets)){\n  if(!exact(bundle,['app','runtime'])||managed&&!bundle.runtime||!managed&&bundle.runtime!==undefined)throw new Error('Python, Java и .NET требуют runtime; Go, Rust и native содержат готовую программу без runtime.');\n  const app=asset(bundle.app,{local:true}),runtime=bundle.runtime?asset(bundle.runtime,{local:true}):undefined;\n  if(python&&!runtime?.url)throw new Error('Автоматическая поставка Python требует закреплённый удалённый runtime.');\n  const extension={python:/\\.py$/i,java:/\\.jar$/i,dotnet:/\\.dll$/i}[value.adapter];\n  if(extension&&!extension.test(app.entrypoint))throw new Error('Точка входа приложения не соответствует adapter '+value.adapter+'.');\n  assets[target]={app,...(runtime?{runtime}:{})};\n }\n return {type:'runtime',adapter:value.adapter,assets,...(python?{python}:{})};\n}\nconst runtimeSourceTargets=source=>Object.keys(validateRuntimeSource(source).assets);\nfunction runtimeAdapterLabel(adapter){if(!Object.hasOwn(adapters,adapter))throw new Error('Неизвестный runtime adapter.');return adapters[adapter];}\nmodule.exports={validateRuntimeSource,runtimeSourceTargets,runtimeAdapterLabel,isPublicRuntimeAddress};\n"
    },
    {
      "path": "services/shared/tool-supply-paths.cjs",
      "content": "'use strict';\n\nconst TOOL_SOURCE_MAX_BYTES=256*1024*1024;\nconst checkedSha=value=>{if(typeof value!=='string'||!/^[a-f0-9]{64}$/.test(value))throw new TypeError('Нужен точный SHA-256 файла поставки.');return value;};\n/** The same envelope always locates its opaque source and immutable runtime bytes by SHA. */\nconst toolRuntimePath=sha=>'artifacts/'+checkedSha(sha)+'.tar.gz';\nconst toolSourcePath=sha=>'source/'+checkedSha(sha)+'.source';\n/** A public recipe cannot shadow another role's different bytes or a transport document. */\nfunction assertToolSupplyLayout(asset){\n    const paths=new Map([['asset.json',{name:'asset.json',sha:'descriptor'}],['readme.md',{name:'README.md',sha:'readme'}]]);\n    const add=(name,sha)=>{const key=name.normalize('NFC').toLowerCase();for(const [known,saved]of paths){if(known===key&&saved.sha===sha&&saved.name===name)return;if(known===key||known.startsWith(key+'/')||key.startsWith(known+'/'))throw new Error('Пути ролей поставки конфликтуют.');}paths.set(key,{name,sha});};\n    const artifacts=asset.kind==='skill'&&asset.delivery.type==='inline'?[]:asset.delivery.artifacts;\n    if(!Array.isArray(artifacts))throw new Error('Неподдерживаемая доставка ассета.');\n    for(const {descriptor}of artifacts)add(toolRuntimePath(descriptor.sha256),descriptor.sha256);\n    if(asset.source.type==='archive')add(toolSourcePath(asset.source.sha256),asset.source.sha256);\n    if(asset.recipe)add(asset.recipe.path,asset.recipe.sha256);\n}\nmodule.exports={TOOL_SOURCE_MAX_BYTES,toolRuntimePath,toolSourcePath,assertToolSupplyLayout};\n"
    },
    {
      "path": "services/shared/tool-supply-paths.d.cts",
      "content": "export const TOOL_SOURCE_MAX_BYTES:number;\nexport function toolRuntimePath(sha:string):string;\nexport function toolSourcePath(sha:string):string;\nexport function assertToolSupplyLayout(asset:{kind?:string;delivery:{type?:string;artifacts?:Array<{descriptor:{sha256:string}}>};source:{type:string;sha256?:string};recipe?:{path:string;sha256:string}}):void;\n"
    }
  ],
  "sources": [
